// Jalon — Phase 1 data model
// Multi-tenancy strategy: shared schema, every tenant-scoped table carries
// an `organizationId` foreign key + index. Enforce isolation at the query
// layer (see src/lib/tenant.ts) until/unless Postgres RLS is added later —
// that decision is flagged as open in the spec (§10) and should be
// confirmed with the developer before this goes further.

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy, users, roles
// ---------------------------------------------------------------------------

model Organization {
  id            String    @id @default(cuid())
  name          String
  nextAuditDate DateTime?
  createdAt     DateTime  @default(now())

  // Current Qualiopi certificate identity, copied from the paper
  // certificate the certifier issues (modeled on a real AB Certification
  // one): the certificate is REISSUED at each renewal with a new 3-year
  // validity but keeps its number and original issue date, so a single
  // set of org-level fields tracks "the current certificate" while
  // QualiopiAudit rows below carry the full audit history.
  qualiopiCertificateNumber String?
  qualiopiCertifier         String? // organisme certificateur (ex. AB Certification)
  qualiopiCertifiedSince    DateTime? // date d'émission initiale
  qualiopiCertificateUntil  DateTime? // date de fin de validité (cycle de 3 ans)
  qualiopiCategories        String? // catégories L.6313-1 couvertes, texte libre

  // L'organisme réalise-t-il des actions de formation par apprentissage ?
  // Cinq indicateurs du RNQ (13 à 16 et 20, plus le 33 du projet 2026) ne
  // concernent qu'elles : un OF qui n'en fait pas ne peut structurellement
  // pas les couvrir, et son score de conformité plafonnait donc à 27/32
  // sans qu'il puisse rien y faire.
  //
  // Nullable À DESSEIN, et pas `false` par défaut : répondre "non" pour
  // tout le monde masquerait ces indicateurs à un CFA qui en a réellement
  // besoin, ce qui est la direction dangereuse de l'erreur. Tant que
  // personne n'a répondu, tout reste affiché et compté comme avant — l'UI
  // pose simplement la question là où le chiffre est faux.
  deliversApprenticeship Boolean?

  // Public-facing contact shown on the public course pages (indicator 1's
  // "contacts" item) — deliberately separate from billing identity and
  // from any staff member's personal email.
  publicContactEmail String?
  publicContactPhone String?

  // Billing identity for the ORGANIZATION'S OWN Jalon subscription —
  // the org is the paying customer, so this is what a real invoice from
  // Jalon to them would need (Stripe customer creation, French invoice
  // legal-mention requirements). Collected at signup (see /essai). Not to
  // be confused with the org's own Company/Contact records, which are
  // their end customers, a separate concern.
  siret             String?
  billingAddress    String?
  billingPostalCode String?
  billingCity       String?
  // Unlike siret/billingAddress above, required from every new signup (see
  // the schema in /api/signup) — Jalon needs a phone contact for every
  // customer, not just those who volunteer full billing details up front.
  // Nullable at the DB level regardless, since existing organizations
  // predate this requirement and can't be backfilled.
  billingPhone      String?

  // Legal identity mentions the OFP needs printed on documents it issues
  // to ITS OWN clients (contracts, conventions, CGV — the French "mentions
  // légales" block: forme juridique + capital social + siège social + RCS +
  // représentant légal). Distinct from the billing fields above, which are
  // about Jalon invoicing the org, not the org invoicing its clients.
  // Editable from /profil (ADMIN_OF only) and merged into templates via
  // mergeTemplate.ts's AVAILABLE_MERGE_FIELDS.
  legalForm                 String?
  shareCapital              String?
  legalAddress              String?
  rcsCity                   String?
  rcsNumber                 String?
  legalRepresentativeName   String?
  // Numéro de déclaration d'activité (NDA), délivré par la DREETS —
  // obligatoire sur tout contrat/convention de formation (art. L.6351-1 du
  // Code du travail). Distinct du numéro RCS ci-dessus.
  activityDeclarationNumber String?

  // Régime de TVA, pour les mentions de la facture.
  //
  // "exempt" : la formation professionnelle continue est exonérée par
  // l'article 261-4-4°a du CGI, sous réserve de l'attestation délivrée par
  // la DREETS. C'est le cas le plus fréquent, donc le défaut — mais pas une
  // vérité universelle : un organisme non déclaré ou hors champ facture avec
  // TVA. Le choix est donc déclaré par l'organisme, jamais deviné : émettre
  // une facture au mauvais régime est une erreur que son client et son
  // comptable subissent tous les deux.
  vatRegime      String  @default("exempt") // exempt | standard
  vatRatePercent Float?
  // N° de TVA intracommunautaire, obligatoire dès qu'on facture avec TVA.
  vatNumber      String?

  // Numérotation des factures — audit P1 : « comment cela se passe si le
  // client fait d'autres factures via son outil en dehors de la
  // plateforme ? ». Le code des impôts impose une séquence chronologique
  // continue par organisme, pas par outil : un OF qui a déjà émis 46
  // factures ailleurs doit pouvoir dire à Jalon de démarrer à 47.
  //
  // NULL des deux côtés = comportement historique (FAC-<année>-<rang dans
  // l'année>), conservé pour ne pas renuméroter sous les pieds d'un
  // organisme déjà en route. Dès que ces deux champs sont renseignés,
  // c'est la séquence de l'organisme qui fait foi : invoiceNextNumber est
  // incrémenté de façon atomique à chaque émission, donc deux factures
  // créées en même temps ne peuvent pas recevoir le même numéro — ce que
  // l'ancien comptage de lignes ne garantissait pas.
  invoicePrefix     String?
  invoiceNextNumber Int?

  // Date de reprise du « à faire » : rien d'antérieur ne remonte comme
  // tâche. Pensée pour la migration — un organisme qui verse trois ans
  // d'historique dans Jalon n'y a coché aucune case, et tout son passé
  // apparaîtrait comme du travail en retard.
  //
  // Une DATE et non des lignes de rejet, et c'est le point important : la
  // première version de cette fonction créait un DashboardTaskDismissal par
  // tâche. Or les tâches sont plafonnées par famille avant d'être filtrées,
  // si bien que masquer les 100 tâches calculées laissait les 3 800 autres
  // hors de portée — et pire, les 100 lignes masquées continuaient à
  // consommer le plafond, rendant la famille vide pour toujours. Un seuil
  // appliqué DANS la requête n'a aucun de ces défauts : il est exact quel
  // que soit le volume, tient en un champ, et s'annule en le vidant.
  tasksHiddenBefore DateTime?

  // Marque blanche — what an OFP's own learners see never needs to say
  // "Jalon": the public token pages (recueil des besoins, satisfaction,
  // activation) already show organization.name instead of the platform
  // name. logoUrl/brandColor extend that to a real visual identity —
  // replacing the generic Milestone-icon mark and its fixed seal color —
  // applied there and in the authenticated learner portal (Sidebar, when
  // role is LEARNER; staff keep the regular Jalon-branded chrome, since
  // they're Jalon's own customers). A dedicated subdomain per OFP is a
  // further step the roadmap calls for but isn't implemented yet — it
  // needs a real domain to route from, which doesn't exist yet.
  logoUrl    String?
  brandColor String?

  // Cancellation indemnity applied when a learner cancels late — a
  // commercial policy, not a property of any one course, hence its place
  // here. Null means the organisation has chosen not to charge one at all,
  // in which case the clause and its reciprocal both disappear from the
  // generated contract: they can never be separated, since an indemnity
  // running only against the consumer is a presumed-unfair clause
  // (art. R.212-2, 3° C. consom.).
  cancellationFeePercent Int?
  // What a learner may open while their withdrawal period is still running:
  // "closed" holds everything back until it expires, "partial" opens only
  // the items flagged on ElearningModule.availableDuringWithdrawal.
  // The risk of opening content early is the organisation's own, not the
  // learner's — it performs while the learner can still withdraw and be
  // fully reimbursed — so this is deliberately its call.
  withdrawalAccessPolicy String    @default("closed") // closed | partial
  // Filled once, then reused: these appear in every generated contract but
  // belong to no other record, and asking for them on each document would
  // be absurd.
  regionPrefecture       String?
  mediatorName           String?
  mediatorContact        String?
  // Written when the organisation knowingly accepts a payment schedule
  // exceeding the 30 % ceiling of art. L.6353-6. Blocking was deliberately
  // ruled out — this is a commercial decision the organisation is entitled
  // to make — but it is recorded, and the record serves the organisation
  // first: the day one of them disputes having been informed, this is the
  // answer. Memorised so the warning stops reappearing on every contract,
  // which is how a warning becomes wallpaper nobody reads.
  paymentCapAckAt        DateTime?
  paymentCapAckByName    String?

  // « À faire plus tard » sur l'adhésion à un médiateur de la consommation.
  //
  // Un report, pas un renoncement : l'obligation de l'art. L.612-1 ne
  // s'éteint pas parce qu'on a cliqué. Le champ fait taire le rappel jusqu'à
  // cette date, et l'étape de démarrage reste décochée pendant tout ce
  // temps — une check-list qui annonce terminé ce qui ne l'est pas ne sert
  // plus à rien. Voir lib/mediationConsommation.ts pour la règle complète,
  // et notamment pourquoi le rappel ne se déclenche QUE chez un organisme
  // qui vend réellement à des particuliers.
  mediatorReminderSnoozedUntil DateTime?

  users                   User[]
  contacts                Contact[]
  companies               Company[]
  dossiers                Dossier[]
  opportunities           Opportunity[]
  courses                 Course[]
  sessions                Session[]
  quotes                  Quote[]
  invoices                Invoice[]
  payments                Payment[]
  processingActivities    ProcessingActivity[]
  subProcessors           SubProcessor[]
  qualiopiIndicators      QualiopiIndicatorEvidence[]
  auditChecklistItems     AuditChecklistItem[]
  dpiaRecords             DPIARecord[]
  sessionInvitations      SessionInvitation[]
  nonConformities         NonConformity[]
  qualiopiAudits          QualiopiAudit[]
  intervenantEvaluations  IntervenantEvaluation[]
  rightsRequests          RightsRequest[]
  dataBreaches            DataBreach[]
  documents               Document[]
  documentTemplates       DocumentTemplate[]
  needsAssessmentRequests NeedsAssessmentRequest[]
  emailMessages           EmailMessage[]
  mailboxConnections      MailboxConnection[]
  integrationCredentials  IntegrationCredential[]
  integrationRequests     IntegrationRequest[]
  funders                 Funder[]
  fundingCommitments      FundingCommitment[]
  apiKeys                 ApiKey[]
  webhooks                Webhook[]
  clientOutreaches        ClientOutreach[]
  subscription            Subscription?

  // Manual access control, set by Jalon's own platform owner (a distinct
  // surface from every Organization's own app — see src/lib/platformAdmin.ts)
  // — deliberately separate from Subscription.status, which mirrors Stripe's
  // payment state via webhook and must never be silently overwritten by a
  // human decision, or vice versa. accessWarningAt is the soft step (every
  // user in the org sees a persistent banner, nothing is blocked);
  // suspendedAt is the hard one (no page in (app)/ renders for anyone in
  // the org until it's cleared) — see AppLayout, which is where both are
  // actually enforced. Edge middleware can't run this check itself (Prisma's
  // Node engine doesn't run there), hence the layout-level gate instead.
  suspendedAt         DateTime?
  suspendedReason     String?
  accessWarningAt     DateTime?
  accessWarningReason String?
  // Date à laquelle l'organisme a accepté les CGV de Jalon — saisie à la
  // main par le propriétaire de la plateforme (rien ne la capture
  // automatiquement aujourd'hui, ni à l'inscription essai ni au paiement
  // Stripe), donc nullable tant qu'elle n'a pas été renseignée.
  cgvAcceptedAt       DateTime?

  qualityRisks                QualityRisk[]
  resultIndicators            ResultIndicator[]
  dashboardTaskDismissals     DashboardTaskDismissal[]
  activationEvents            ActivationEvent[]
  orgChartSnapshots           OrgChartSnapshot[]
  satisfactionSurveys         SatisfactionSurvey[]
  satisfactionSurveyResponses SatisfactionSurveyResponse[]
  bankConnections             BankConnection[]
  bankTransactions            BankTransaction[]
  // Emails envoyés par le propriétaire de la plateforme depuis /plateforme
  // (voir PlatformEmailMessage) — sans lien avec EmailMessage/ClientOutreach,
  // qui sont la boîte mail de CET organisme vers SES PROPRES prospects.
  platformEmailMessages       PlatformEmailMessage[]
  // Prises de contact notées à la main par le propriétaire de la plateforme
  // (appel, rendez-vous...) — fusionnées avec platformEmailMessages dans la
  // frise "Activité" de la fiche organisme, comme l'onglet Activité du CRM
  // de chaque OFP fusionne plusieurs sources.
  platformContactNotes        PlatformContactNote[]

  // Which version of the RNQ this org is currently auditing itself against
  // (see QualiopiReferentielVersion) — nullable only until the backfill
  // migration sets every existing org to the 2022 version; every org gets
  // one from creation onward in practice.
  activeReferentielVersion   QualiopiReferentielVersion? @relation("ActiveReferentiel", fields: [activeReferentielVersionId], references: [id])
  activeReferentielVersionId String?

  // The person designated as référent handicap (RNQ indicator 20) — not a
  // separate Role, since in practice this is a specific person on an
  // existing team (often a TRAINER or ADMIN_MANAGER) wearing an extra hat,
  // not a distinct job function needing its own permission tier. Access to
  // AccommodationRequest is gated on being this specific user (or an admin),
  // not on role alone — see canAccessAccommodations in src/lib/tenant.ts.
  referentHandicapUser   User?   @relation("ReferentHandicap", fields: [referentHandicapUserId], references: [id])
  referentHandicapUserId String?

  accommodationRequests AccommodationRequest[]
  complaints            Complaint[]
  secureReports         SecureReport[]
  regulatoryWatchItems  RegulatoryWatch[]
  subcontractors        Subcontractor[]
  automationRules       AutomationRule[]
}

// Confidential — situation de handicap is sensitive personal data under
// RGPD art. 9 (special category). description/requestedAccommodations are
// never shown to anyone outside canAccessAccommodations() (admins + the
// designated référent handicap), not even other staff with normal "dossiers"
// access. See RNQ indicators 13/16/20.
model AccommodationRequest {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  dossier        Dossier      @relation(fields: [dossierId], references: [id])
  dossierId      String

  description             String
  requestedAccommodations String
  status                  String    @default("pending") // pending | granted | declined
  grantedAccommodations   String?
  handledByUserId         String?
  handledByName           String?
  handledAt               DateTime?

  createdByName String
  createdAt     DateTime @default(now())

  @@index([organizationId])
  @@index([dossierId])
}

// A learner (or staff) complaint about a training — separate from
// EmailMessage/inbox (that's unstructured correspondence; this is a
// tracked complaint with a status workflow) and separate from
// NonConformity (which is Qualiopi reference data feeding the amélioration
// continue register — a resolved Complaint can become a NonConformity/risk
// input, but the two aren't the same record).
model Complaint {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  dossier        Dossier?     @relation(fields: [dossierId], references: [id])
  dossierId      String?

  subject          String
  description      String
  submittedByName  String
  // Captured at submission time from the (always-authenticated) submitter's
  // session — client feedback: staff need to find the complainant's email
  // straight from the request, not go hunting for their dossier/contact
  // record first. Clickable as a mailto: link in the UI.
  submittedByEmail String?
  // Which intent the unified support dialog's picker was set to — "complaint"
  // | "question" | "other" — purely for staff triage, same underlying model
  // and workflow either way.
  category         String    @default("other")
  status           String    @default("open") // open | investigating | resolved
  resolutionNotes  String?
  resolvedAt       DateTime?

  // Client feedback: a request should be assignable to a specific staff
  // member with their own working note and a deadline, independent of the
  // open/investigating/resolved status — assignment is "whose job is this"
  // while status is "where is it at."
  assignedToUserId String?
  assignedToName   String?
  assigneeComment  String?
  assigneeDeadline DateTime?
  // Manual, independent of status — client feedback: a resolved complaint
  // shouldn't just pile up in the main list forever; give staff an explicit
  // "Archivées" tab to move it out of the way once truly done with it.
  archivedAt       DateTime?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([dossierId])
}

// Deliberately separate from Complaint: a harassment/discrimination report
// needs a much smaller circle of people able to read it (see
// canAccessSecureReports in src/lib/tenant.ts — admins only, no "référent"
// carve-out like accommodations has, since the report could be about
// anyone including a référent). reporterName/reporterContact are optional
// — an anonymous report is still a valid report. SecureReportAccessLog
// gives the traceability the escalation procedure needs: every time an
// admin actually views a report, that's logged and visible to every admin,
// not hidden even from the viewer themselves.
model SecureReport {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  reporterName    String?
  reporterContact String?
  description     String
  status          String    @default("received") // received | under_review | escalated | closed
  escalationNotes String?
  escalatedAt     DateTime?

  // Same reasoning as Complaint above — "whose job is this" independent of
  // status, plus an explicit archive so a closed report doesn't linger in
  // the main confidential-channel list forever.
  assignedToUserId String?
  assignedToName   String?
  assigneeComment  String?
  assigneeDeadline DateTime?
  archivedAt       DateTime?

  createdAt DateTime @default(now())

  accessLog SecureReportAccessLog[]

  @@index([organizationId])
}

model SecureReportAccessLog {
  id             String       @id @default(cuid())
  report         SecureReport @relation(fields: [reportId], references: [id])
  reportId       String
  viewedByUserId String
  viewedByName   String
  viewedAt       DateTime     @default(now())

  @@index([reportId])
}

// RNQ indicators 22-25 ask for more than "we monitor X source" — an
// auditor wants to see a watch item actually turn into a decision and a
// concrete action, not sit as a logged link nobody acted on. status tracks
// that progression explicitly (identified → decided → exploited) rather
// than leaving it to be inferred from which optional fields are filled;
// exploitedAt is the field that answers "was this actually put into
// practice," which is the part a source-logging tool usually skips.
model RegulatoryWatch {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  watchType String // legal | metiers_competences | pedagogique_technologique | reseaux_partenariats
  source    String
  watchDate DateTime
  summary   String
  ownerName String

  decision     String?
  actionTaken  String?
  exploitedAt  DateTime?
  evidenceNote String?
  status       String    @default("identified") // identified | decided | exploited

  affectedCourses Course[]

  createdByName String
  createdAt     DateTime @default(now())

  @@index([organizationId])
}

// A trainer/subcontractor delivering training on the org's behalf — the
// record the org keeps for Qualiopi indicator 17 (qualification of
// external/internal staff) and indicator 19 (coordination/supervision of
// intervenants), independent of whether they ever get a Jalon account.
// Documents (contract, diploma, insurance...) reuse the existing Document
// model via subcontractorId rather than a parallel table.
// Client feedback: a formateur_externe should be assignable to a session
// like any other trainer — rather than duplicating Session.trainerId to
// accept a Subcontractor too, `linkedUser` is the bridge: an admin can send
// a real platform invitation (same flow as inviting a staff member, see
// /api/team/invite) that creates a User row and links it back here. Once
// linked, they show up in every trainer picker exactly like a regular
// TRAINER — no separate "or a subcontractor" branching needed anywhere else
// in the codebase. Until invited, they're a pure record with no login.
model Subcontractor {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  name           String
  type           String // formateur_externe | sous_traitant_pedagogique | prestataire_technique | autre
  // French OFPs contract both registered companies and individual
  // freelancers (auto-entrepreneurs) — the two carry different legal
  // mentions on a contract (a company has a raison sociale + forme
  // juridique; an individual just has their own SIRET, if any).
  isIndividual   Boolean @default(false)
  legalForm      String? // company only — SARL, SAS, EI... blank/meaningless for an individual
  siret          String?
  address        String?
  contactEmail   String?
  contactPhone   String?
  qualifications String? // free text: diplomas, certifications, specialties

  contractStartDate       DateTime?
  contractEndDate         DateTime?
  qualificationExpiryDate DateTime? // e.g. a certification's expiry — distinct from the contract's own end date

  status String  @default("active") // active | expired | terminated
  notes  String?

  linkedUser   User?   @relation(fields: [linkedUserId], references: [id])
  linkedUserId String? @unique

  documents   Document[]
  evaluations IntervenantEvaluation[]
  courses     Course[]                @relation("CourseSubcontractors")

  createdAt DateTime @default(now())

  @@index([organizationId])
}

// One row per organization, created at signup. Spec §8's "14-day trial, no
// credit card required" means status starts at "trialing" with no Stripe
// customer/subscription id yet — those two fields, and the "active"/
// "past_due"/"canceled" statuses, only get populated once Stripe (or
// another processor) is actually wired in via /integrations and its
// webhook flips the status on payment events. Nothing in this codebase
// calls Stripe yet; this table exists so that wiring is "update a row",
// not "design a schema", when the time comes.
model Subscription {
  id                   String       @id @default(cuid())
  organization         Organization @relation(fields: [organizationId], references: [id])
  organizationId       String       @unique
  plan                 String // solo | team | growth
  status               String       @default("trialing") // trialing | active | past_due | canceled
  trialEndsAt          DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  // Mirrored from Stripe by the billing webhook, never set by the app
  // itself: Stripe is the source of truth on what was actually paid and
  // until when. Kept locally so the UI can answer "jusqu'à quand ?" without
  // an API round-trip on every page load.
  currentPeriodEnd     DateTime?
  // Stripe keeps a cancelled subscription active until the end of the paid
  // period. Without this flag the UI would show "Actif" to someone who has
  // already cancelled, which is exactly the moment not to be misleading.
  cancelAtPeriodEnd    Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

// Un email envoyé (ou programmé) par le propriétaire de la plateforme à un
// organisme, depuis sa fiche sur /plateforme — pas une relance automatisée
// (celles-là restent dans ClientOutreach, propres à chaque organisme) mais
// une communication ponctuelle de Jalon vers SON client. scheduledAt null =
// envoyé immédiatement à la création ; renseigné = laissé au cron
// /api/cron/platform-emails, qui envoie tout ce dont l'échéance est passée
// et n'a pas encore de sentAt. La ligne existe dès la création (envoyée ou
// non) pour garder un historique consultable sur la fiche, y compris pour
// ce qui est encore en attente.
model PlatformEmailMessage {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  toEmail        String
  subject        String
  body           String
  scheduledAt    DateTime?
  sentAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// Une prise de contact notée à la main par le propriétaire de la plateforme
// — appel, rendez-vous, échange hors email — pour tout ce qui n'existe pas
// déjà comme PlatformEmailMessage. occurredAt est distinct de createdAt : un
// appel se note souvent après coup, la frise doit trier sur "quand c'est
// arrivé", pas "quand ça a été saisi".
model PlatformContactNote {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  note           String
  occurredAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// The dashboard's "À faire" list is computed live from dossier/invoice/etc.
// state every page load — there's no underlying row to mark done, so
// "ignorer" needs its own record instead. Keyed by (kind, entityId), the
// same composite the widget already uses as its React key, and scoped to
// the whole org rather than per-user — simpler, and matches "this doesn't
// need chasing" being a shared team decision, not a personal one.
model DashboardTaskDismissal {
  id                String       @id @default(cuid())
  organization      Organization @relation(fields: [organizationId], references: [id])
  organizationId    String
  kind              String
  entityId          String
  dismissedByUserId String
  dismissedAt       DateTime     @default(now())

  @@unique([organizationId, kind, entityId])
  @@index([organizationId])
}

// One row per organization per milestone, never repeated (the unique
// constraint below, paired with skipDuplicates at the call site, IS the
// "first" in "first course created" — no need to compute MIN(createdAt)
// later). Answers "what % of trials reach activation" — audit S6 (M3)
// found this unmeasured: track.ts only ever covered marketing conversion
// (GA4, loaded on public pages), never in-app product usage. Deliberately
// NOT routed through track.ts/gtag: GA4 is gated to anonymous marketing
// pages by design (see CookieConsent.tsx), and sending per-org product
// activity to a third-party ad platform from inside the authenticated app
// would be an odd fit for a Qualiopi-compliance tool. This is a first-party,
// internal log only — queried by hand (Prisma Studio) for now.
model ActivationEvent {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  type           String
  createdAt      DateTime     @default(now())

  @@unique([organizationId, type])
  @@index([organizationId])
}

// A dated, frozen copy of the org chart (who was on the team, in which
// role, and which subcontractors were tracked, grouped exactly like the
// live "Organigramme" tab) — client feedback: the live view always
// reflects today's team, but a Qualiopi audit may ask "who was on staff
// as of [past date]", so staff can snapshot the current grouping on demand
// and pull it back up later instead of reconstructing it from memory.
model OrgChartSnapshot {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  createdAt      DateTime     @default(now())
  createdByName  String
  data           Json

  @@index([organizationId, createdAt])
}

enum Role {
  ADMIN_OF
  ADMIN_MANAGER
  SALES
  TRAINER
  LEARNER
  DPO_EXTERNAL
}

model User {
  id                          String       @id @default(cuid())
  organization                Organization @relation(fields: [organizationId], references: [id])
  organizationId              String
  email                       String       @unique
  name                        String
  role                        Role
  status                      String       @default("active") // active | invited | disabled
  passwordHash                String? // null while status = "invited" — set once the member activates their account
  activationToken             String?      @unique // set alongside status="invited"; consumed by /activation/[token]
  // "Mot de passe oublié" — set by /api/public/forgot-password, consumed by
  // /reinitialiser-mot-de-passe/[token]. Unlike activationToken this always
  // carries an expiry: an activation link is issued once by staff to a
  // known invitee, but a reset link is self-service and publicly requestable
  // by anyone typing an email address, so a stale unconsumed link staying
  // valid forever is a real risk, not just a tidiness concern.
  passwordResetToken          String?      @unique
  passwordResetTokenExpiresAt DateTime?
  // Stamped whenever /api/public/reset-password succeeds — never on account
  // creation/activation, since there's no prior session to invalidate then.
  // getSessionContext() (lib/tenant.ts) compares this against the value
  // frozen into a JWT at sign-in: a token older than the latest reset is
  // treated as unauthenticated, so a "mot de passe oublié" someone triggers
  // because a device was compromised actually logs that device out, instead
  // of leaving its 30-day session valid until it happens to expire.
  passwordChangedAt           DateTime?
  createdAt                   DateTime     @default(now())
  // Sanitized HTML, set by the user themselves on /profil — auto-appended
  // to composed messages (client feedback: "la même signature qu'un mail
  // classique envoyé depuis sa boîte normale"). No auto-import from a
  // connected Gmail/IMAP mailbox: IMAP has no protocol-level concept of a
  // signature, and Gmail's lives behind a broader OAuth scope than this
  // app currently requests — this is the practical always-works version.
  emailSignature              String?
  // Personal order/width for the dashboard's draggable banner widgets
  // (Prise en main, À faire, Réclamations, Signalements confidentiels —
  // see DashboardWidgetGrid): [{ id: string, span: 1 | 2 }]. Null until the
  // user first drags or resizes something, at which point every widget's
  // id and span is written, not just the one that changed, so a partial
  // write can never leave a stale id pointing at a widget that no longer
  // renders. An id absent from this array (a widget added after the user
  // last customized their layout) falls back to appearing last, full width.
  dashboardLayout             Json?

  trainerSessions                  Session[]               @relation("SessionTrainer")
  learnerDossiers                  Dossier[]               @relation("DossierLearnerUser")
  referentHandicapForOrganizations Organization[]          @relation("ReferentHandicap")
  intervenantEvaluations           IntervenantEvaluation[]
  responsibleForCourses            Course[]                @relation("CourseResponsibles")
  subcontractorRecord              Subcontractor?
  documents                        Document[]              @relation("UserDocuments")
  notificationDismissals           NotificationDismissal[]

  @@index([organizationId])
}

// La cloche de notifications (NotificationBell.tsx) recalcule sa liste "à
// faire" en direct depuis dashboardTasks.ts à chaque chargement — il n'y a
// donc rien à marquer "lu" sur la tâche elle-même, seulement "je l'ai déjà
// vue" côté lecteur. Personnel (userId), pas par organisation comme
// DashboardTaskDismissal : "j'ai déjà vu cette relance" est un état de
// lecture propre à chacun, pas une décision d'équipe partagée — ce que
// l'audit S6 (finding M5) demandait : partagé entre les appareils d'UNE
// même personne, plutôt que prisonnier d'un seul navigateur.
model NotificationDismissal {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  kind        String
  entityId    String
  dismissedAt DateTime @default(now())

  @@unique([userId, kind, entityId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// CRM: contacts, companies, dossiers
// ---------------------------------------------------------------------------

model Company {
  id                      String       @id @default(cuid())
  organization            Organization @relation(fields: [organizationId], references: [id])
  organizationId          String
  name                    String
  siret                   String?
  address                 String?
  // Client feedback: when a training is company-funded (learnerCategory
  // employee/apprentice — see Dossier below), the OFP needs a named
  // point of contact at the company, not just its identity — stored
  // directly here rather than a separate contact-person table, same
  // pattern as Subcontractor's own contactEmail/contactPhone.
  responsableFirstName    String?
  responsableLastName     String?
  responsableEmail        String?
  responsablePhone        String?
  // Free-text "Name, Fonction" (e.g. "Julie Martin, DRH") — the person who
  // signs a convention on the company's behalf. Deliberately not split into
  // separate name/title fields, same shape as Organization.legalRepresentativeName;
  // distinct from responsable* above, which is the day-to-day HR contact and
  // not necessarily the signatory. Nullable: only needed once a convention is
  // actually generated, and legal identity (forme juridique, capital social,
  // RCS) was deliberately left out of this model — a training convention's
  // client-company header only needs name + SIRET + signatory to be usable,
  // unlike the OF's own header where the fuller identity is standard.
  legalRepresentativeName String?

  contacts Contact[]

  @@index([organizationId])
}

// A Contact is a person (prospect, learner, HR contact, trainer contact...).
// IMPORTANT: emails are matched and stored against a Contact, never directly
// against a Dossier — see MailboxConnection / EmailMessage below and spec §5.11.
model Contact {
  id                     String       @id @default(cuid())
  organization           Organization @relation(fields: [organizationId], references: [id])
  organizationId         String
  firstName              String
  lastName               String
  email                  String
  phone                  String?
  // The person's own postal address — distinct from Company.address (the
  // employer's business address, entered separately via EditCompanyForm).
  // Single free-text field, same convention as Company.address, not split
  // into street/postal/city.
  address                String?
  // A training contract with a natural person identifies them by date of
  // birth as well as by name — namesakes exist, and the certification
  // registries key on it. Nullable: only contracts need it, and a CRM
  // prospect is created long before anyone asks.
  birthDate              DateTime?
  company                Company?     @relation(fields: [companyId], references: [id])
  companyId              String?
  createdAt              DateTime     @default(now())
  // Client feedback: category (and company, via companyId above) should be
  // capturable the moment a new contact exists — even before any formation
  // enrollment — e.g. from the CRM "Nouveau prospect" form. Dossier has its
  // own learnerCategory (the one actually used for BPF reporting once
  // enrolled); this is only the carried-forward default a later enrollment
  // falls back to when the caller doesn't specify one explicitly — see
  // resolveContact in lib/enrollment.ts.
  defaultLearnerCategory String? // employee | jobseeker | individual | apprentice
  // Set automatically when one of their opportunities reaches PAID (client
  // feedback: a paid deal means the relationship is closed out, not still
  // an active prospect to keep chasing) — hides them from the default CRM
  // view the same way Course.archivedAt hides finished formations.
  archivedAt             DateTime?

  // Commercial-relationship fields, all optional — the "prospect" is real
  // from their very first CRM entry, before any of these are known. Live
  // on Contact (the persistent relationship), not Dossier (one course
  // engagement): a person's sector, priority, marketing consent and sales
  // notes don't reset between the different formations they take over time.
  industry       String? // secteur d'activité
  urgencyLevel   String? // low | medium | high — sales-set priority, not derived
  // *Consent is null until a staff member records an answer either way —
  // distinct from false, which means "asked, declined." *ConsentAt stamps
  // WHEN that answer (true or false, both are real answers) was last
  // confirmed, and is cleared back to null only alongside null — this is a
  // manual record kept by staff, not a real double opt-in flow.
  emailConsent   Boolean?
  emailConsentAt DateTime?
  smsConsent     Boolean?
  smsConsentAt   DateTime?
  notes          String?

  dossiers                Dossier[]
  emailMessages           EmailMessage[]
  quotes                  Quote[]
  invoices                Invoice[]
  opportunities           Opportunity[]
  needsAssessmentRequests NeedsAssessmentRequest[]
  clientOutreaches        ClientOutreach[]
  documents               Document[]               @relation("ContactDocuments")

  @@unique([organizationId, email])
  @@index([organizationId])
  // Filtre par défaut du CRM et des listes.
  @@index([archivedAt])
}

// A specific training engagement for a Contact. A Contact can have many
// Dossiers over time (repeat clients) — this is why email auto-linking
// resolves to a Contact first, then suggests a Dossier (see spec §5.11).
model Dossier {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  contact        Contact      @relation(fields: [contactId], references: [id])
  contactId      String
  session        Session      @relation(fields: [sessionId], references: [id])
  sessionId      String
  learnerUser    User?        @relation("DossierLearnerUser", fields: [learnerUserId], references: [id])
  learnerUserId  String? // set once the learner has portal access

  needsAssessmentDone Boolean @default(false)
  contractSigned      Boolean @default(false)
  convocationSent     Boolean @default(false)
  evaluationHotDone   Boolean @default(false)
  evaluationColdDone  Boolean @default(false)

  legalBasis     String    @default("contract_performance")
  retentionUntil DateTime?

  // Only meaningful for a ROLLING (self-paced, no fixed date) session: how
  // many days the learner has to finish once they start, and when they
  // actually did start. accessDurationDays is captured at enrollment;
  // firstAccessedAt is set the first time any LMS progress is recorded for
  // this dossier (see markDossierAccessed in lib/lms.ts) — that's the
  // "access" event the learner has no control over faking, unlike a
  // login timestamp which could predate ever opening a module.
  accessDurationDays Int?
  firstAccessedAt    DateTime?

  createdAt DateTime @default(now())

  // Clôture du dossier. Le contact, la formation et la session avaient tous
  // leur archivage ; le dossier non — donc la promotion 2022 restait dans
  // toutes les listes de travail pour toujours (audit S7, P1 n°8).
  //
  // Ce que « clôturé » veut dire, et ce que ça ne veut PAS dire. Un dossier
  // clos sort des listes de travail et ne déclenche plus rien : ni tâche du
  // tableau de bord, ni relance automatique. Il ne disparaît de rien
  // d'autre. En particulier :
  //
  //   — le BPF continue de le compter (une inscription de 2022 reste
  //     déclarée sur 2022 ; l'archivage est un rangement d'écran, jamais
  //     une réécriture de déclaration légale) ;
  //   — les indicateurs de résultats Qualiopi aussi, pour la même raison ;
  //   — l'apprenant garde l'accès à son espace et à ses attestations —
  //     clôturer, c'est classer côté organisme, pas retirer à quelqu'un ce
  //     qui lui appartient ;
  //   — la facturation continue de le voir : une facture impayée sur un
  //     dossier clos reste due.
  //
  // Archiver une session clôture ses dossiers d'un même geste (voir la
  // route archive) : sans ça, refermer une promotion de trente personnes
  // demanderait trente clics, ce qui est exactement le défaut signalé.
  archivedAt DateTime?

  // BPF §5.13 groups learner hours by legal status category. Client
  // feedback: this should be captured right when the learner is enrolled
  // (any entry point — course catalog, planning, course creation), not
  // only editable after the fact from the dossier — see lib/enrollment.ts.
  // Null = "non renseigné", a real, expected state until staff fills it in.
  learnerCategory String? // employee | jobseeker | individual | apprentice

  // Price actually agreed for THIS enrollment, in cents. Deliberately not
  // read from Course.priceCents at display time: a catalogue price is a
  // starting point, and the negotiated price is what the funding plan and
  // the reste à charge have to be computed against. Null = "use the course
  // price" (see resolveDossierPriceCents in src/lib/funding.ts), which is
  // the common case and keeps every existing dossier correct.
  agreedPriceCents Int?

  fundingCommitments FundingCommitment[]

  // Idempotency guard for the automation-rule cron (see
  // /api/cron/automation-rules): stamped the first time an automatic
  // reminder email for that trigger goes out for this dossier, so a rule
  // never re-sends the same nudge on a later run. convocation_missing needs
  // no field of its own — convocationSent (above) is already that guard.
  needsAssessmentAutoReminderSentAt DateTime?
  contractAutoReminderSentAt        DateTime?
  rollingDurationAutoReminderSentAt DateTime?
  satisfactionAutoReminderSentAt    DateTime?
  sessionReminderSentAt             DateTime?

  documents                   Document[]
  qualiopiEvidence            QualiopiIndicatorEvidence[]
  elearningProgress           ElearningProgress[]
  quizAttempts                QuizAttempt[]
  virtualClassAttendances     VirtualClassAttendance[]
  attendanceEntries           AttendanceEntry[]
  accommodationRequests       AccommodationRequest[]
  complaints                  Complaint[]
  invitations                 SessionInvitation[]
  quotes                      Quote[]
  invoices                    Invoice[]
  clientOutreaches            ClientOutreach[]
  satisfactionSurveyResponses SatisfactionSurveyResponse[]
  needsAssessmentRequests     NeedsAssessmentRequest[]
  withdrawalWaiver            WithdrawalWaiver?

  @@index([organizationId])
  @@index([contactId])
  // Volume : Postgres n'indexe pas les clés étrangères tout seul. sessionId
  // sert tous les `include: { dossiers }` (planning, émargement, fiche
  // formation, tâches du tableau de bord) ; learnerUserId est le filtre du
  // portail apprenant, donc la requête la plus fréquente de l'application
  // dès qu'il y a des milliers de comptes.
  @@index([sessionId])
  @@index([learnerUserId])
}

// The learner's express request to access the training content before their
// fourteen-day withdrawal period has run (art. L.221-28, 13° C. consom.).
//
// This row is evidence, not state — its whole value is what it can prove in
// a dispute. Hence every field the proof needs: when, from which address,
// against which exact wording (frozen here, not referenced — the on-screen
// text will change someday and the record must keep saying what THIS
// learner accepted), and that the checkbox started unchecked (a pre-ticked
// box is not express consent). One per dossier, ever: a waiver cannot be
// "re-given", and deleting/recreating one would destroy the evidence.
//
// The ten-day period of art. L.6353-5 C. trav. is d'ordre public and is NOT
// affected by this waiver — that is stated in the accepted text itself.
model WithdrawalWaiver {
  id                       String   @id @default(cuid())
  organizationId           String
  dossier                  Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  dossierId                String   @unique
  acceptedAt               DateTime @default(now())
  ipAddress                String
  textAccepted             String
  checkboxDefaultUnchecked Boolean  @default(true)

  // Sur quel alinéa de l'art. L.221-28 la renonciation repose :
  // "digital_content" (13°, contenu numérique — le droit tombe dès l'accès)
  // ou "service_completed" (1°, service pleinement exécuté dans le délai —
  // le droit tombe à l'achèvement, et une somme proportionnelle reste due
  // en cas de rétractation avant). Ce ne sont pas deux formulations d'une
  // même chose : les effets diffèrent, et invoquer le 13° pour deux jours
  // de présentiel serait mal fondé faute de contenu numérique.
  //
  // Nullable : les lignes antérieures reposent toutes sur le 13°, seul
  // fondement que Jalon connaissait. Leur `textAccepted` le dit déjà — on
  // ne réécrit pas une preuve pour lui ajouter une colonne.
  legalBasis               String?

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Training offer, sessions, planning
// ---------------------------------------------------------------------------

model Course {
  id                        String       @id @default(cuid())
  organization              Organization @relation(fields: [organizationId], references: [id])
  organizationId            String
  title                     String
  description               String?
  // Archiving hides a course from the default catalog view without
  // deleting its history (sessions/dossiers/documents/certificates all
  // stay intact and queryable) — for offers no longer run but still
  // needed for compliance/audit lookback.
  archivedAt                DateTime?
  // Client feedback: a per-course document library should be able to pull
  // the formation's own reference info (title/duration/price) into any
  // document generated from it — see mergeTemplate.ts's course.* fields and
  // DocumentTemplate.courseId below. Nullable: most courses won't bother
  // filling these in until they actually attach a course-scoped template.
  durationHours             Int?
  priceCents                Int?
  // For formations that need periodic renewal (SST, sécurité incendie,
  // habilitations...) — set on the course, locked into Document.expiresAt
  // at the moment a given certificate is actually issued, so a later change
  // here doesn't retroactively alter attestations already granted under a
  // different duration. Null means "no expiry," the default for most
  // courses.
  certificateValidityMonths Int?

  // The 10 mandatory public-information items of RNQ indicator 1 that the
  // free-text description can't reliably carry (the pilot's real 2022 NC:
  // "absence de prérequis" simply wasn't stated anywhere). All free text,
  // all optional — the PUBLIC page renders an explicit "Sans prérequis"
  // when prerequisites is empty, turning the 2022 trap into a default.
  prerequisites         String?
  objectives            String?
  accessDelay           String? // délai d'accès estimé (demande → début)
  accessModalities      String? // processus d'inscription
  teachingMethods       String? // méthodes mobilisées
  evaluationModalities  String?
  // Certification the course prepares for. Nothing recorded this until now,
  // although every CPF-funded contract leans on it and Qualiopi indicator 1
  // requires it to be published. All null when the course leads to no
  // registered certification, which is what makes the contract's
  // certification article appear or disappear.
  certificationName     String?
  certificationCode     String? // RS5839, RNCP39250…
  certificationRegistry String? // "RNCP" | "RS"
  certifierName         String? // autorité responsable de la certification
  // Conditions under which a learner who failed may sit the exam again —
  // contractual, and the question a learner asks first after a failure.
  retakeConditions      String?
  // Opt-in publication of the public course page (/catalogue/[id]) — the
  // OF decides per course; archived courses never render publicly.
  isPublic              Boolean @default(false)
  // What a visitor on the public page can actually DO, on top of reading it:
  //   "none"    — information only (the historical behaviour)
  //   "request" — leaves their details; creates a Contact + Opportunity in
  //               the CRM for staff to qualify. Nothing is committed.
  //   "direct"  — creates the Contact and the Dossier straight away on an
  //               open session, respecting maxLearners.
  // "request" is the safe middle ground and what the UI recommends: "direct"
  // turns unauthenticated form input into real learner records, which most
  // OFs want to vet first. Only meaningful when isPublic is true.
  publicEnrollment      String  @default("none")
  // Opt-in "Passer cette vidéo" button on this course's video modules —
  // off by default so a skip path only exists where the OF has explicitly
  // decided it's acceptable. See ElearningProgress.skippedAt for how a
  // skip is tracked once used.
  allowVideoSkip        Boolean @default(false)

  // Faut-il terminer un module pour ouvrir le suivant ?
  //
  // `true` par défaut, et c'est exactement le comportement qui existait
  // avant ce champ : le déblocage séquentiel était câblé en dur, sans
  // interrupteur. Aucune formation existante ne change de comportement.
  //
  // À `false`, tous les modules s'ouvrent d'un coup dès que l'accès est
  // donné (voir unlockNextModuleIfNeeded) — ce que veut une bibliothèque de
  // ressources qu'on consulte dans le désordre, et sûrement pas un parcours
  // certifiant dont l'ordre porte la progression pédagogique.
  sequentialUnlock Boolean @default(true)

  // Surcharge, pour CETTE formation, de la politique d'accès pendant le
  // délai de rétractation de 14 jours (voir lib/withdrawalGate.ts).
  //
  // `null` = hérite du réglage de l'organisme, ce que fait tout l'existant.
  // Une valeur ici prime. La raison d'être de la surcharge : une formation
  // à 3 000 € en distanciel et un module de 30 minutes ne font pas courir
  // le même risque à l'organisme, et un réglage unique pour tout le
  // catalogue oblige à choisir le plus prudent partout.
  withdrawalAccessPolicy String?

  // Cap on total enrolled learners across ALL of this course's sessions,
  // on top of the per-session Session.capacity (a rolling course's
  // auto-created session gets a generous default capacity, so without
  // this there was no real course-level ceiling). Null means unlimited —
  // the default, and what most courses want.
  maxLearners Int?

  documentTemplates       DocumentTemplate[]
  sessions                Session[]
  elearningModules        ElearningModule[]
  chapters                Chapter[]
  opportunitiesOfInterest Opportunity[]
  qualityRisks            QualityRisk[]
  resultIndicators        ResultIndicator[]
  regulatoryWatchItems    RegulatoryWatch[]
  // Who's accountable for this training — any team member, not just
  // trainers (a course can have an admin/coordinator responsible for it
  // without ever running a session themselves). Distinct from
  // Session.trainerId, which is who actually delivers one specific
  // session — a course can have several sessions with different trainers
  // while keeping the same responsible person(s) throughout.
  responsibleUsers        User[]               @relation("CourseResponsibles")
  // External providers (formateurs externes/prestataires) delivering this
  // training — distinct from responsibleUsers (internal staff accountable
  // for it) and Session.trainerId (an internal trainer delivering one
  // specific session). A course can lean on both internal and external
  // people at once.
  subcontractors          Subcontractor[]      @relation("CourseSubcontractors")
  automationRules         AutomationRule[]
  satisfactionSurveys     SatisfactionSurvey[]

  @@index([organizationId])
}

// Client feedback: at course creation (or later), staff should be able to
// set up "relance" rules instead of relying only on the app's fixed global
// thresholds — e.g. "after N days, flag/relance if the recueil des besoins
// still isn't done." Scoped to a single course rather than global so
// different formations can have different follow-up cadences. `trigger` is
// a free string (one value supported today: needs_assessment_incomplete)
// rather than an enum, so new trigger kinds don't need a migration.
model AutomationRule {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  course         Course       @relation(fields: [courseId], references: [id])
  courseId       String

  trigger      String // see LEARNER... AUTOMATION_TRIGGER_VALUES in lib/automationRules.ts
  afterDays    Int
  // Task-only by default (shows up in the dashboard's "À faire"); an OFP
  // opts a rule into also sending an automatic reminder email to the
  // learner, tracked separately per rule since not every OFP wants
  // unattended emails going out on their behalf. Written once at rule
  // creation (with [Prénom]/[Nom]/... merge tags — see
  // lib/automationRules.ts's fillMergeTags) and reused unedited for every
  // learner the rule fires for, rather than reopened per send.
  sendEmail    Boolean  @default(false)
  emailSubject String?
  emailBody    String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([organizationId])
  @@index([courseId])
}

// Client feedback: "évaluation à chaud/à froid" needs to be a real
// questionnaire (sent, answered, stored) rather than a checkbox staff
// tick by hand — mirrors direct competitors (Digiforma/Dendreo), where a
// satisfaction survey is a first-class product, not a manual step. One
// survey per (course, kind) — kind is "hot" (sent at session end) or
// "cold" (sent per the existing satisfaction_not_collected AutomationRule
// delay) — questions are fully custom per course, same JSON-options
// pattern as QuizQuestion so a single form renderer handles both.
model SatisfactionSurvey {
  id             String                       @id @default(cuid())
  organization   Organization                 @relation(fields: [organizationId], references: [id])
  organizationId String
  course         Course                       @relation(fields: [courseId], references: [id])
  courseId       String
  kind           String // hot | cold
  questions      SatisfactionSurveyQuestion[]
  responses      SatisfactionSurveyResponse[]
  createdAt      DateTime                     @default(now())

  @@unique([courseId, kind])
  @@index([organizationId])
}

model SatisfactionSurveyQuestion {
  id       String             @id @default(cuid())
  survey   SatisfactionSurvey @relation(fields: [surveyId], references: [id])
  surveyId String
  order    Int
  // rating (1-5) | single_choice | multiple_choice | text
  type     String
  prompt   String
  // [{ id, text }] for single_choice/multiple_choice — no "correct" flag,
  // unlike QuizQuestion, since satisfaction has no right answer.
  options  Json?

  @@index([surveyId])
}

model SatisfactionSurveyResponse {
  id             String             @id @default(cuid())
  organization   Organization       @relation(fields: [organizationId], references: [id])
  organizationId String
  survey         SatisfactionSurvey @relation(fields: [surveyId], references: [id])
  surveyId       String
  dossier        Dossier            @relation(fields: [dossierId], references: [id])
  dossierId      String
  // Public-link access, same pattern as NeedsAssessmentRequest — works
  // whether the learner has a mon-espace account or not (client feedback:
  // must work both ways).
  token          String             @unique
  status         String             @default("sent") // sent | completed
  answers        Json? // { [questionId]: string | string[] }
  sentAt         DateTime           @default(now())
  completedAt    DateTime?

  @@unique([surveyId, dossierId])
  @@index([organizationId])
  @@index([dossierId])
}

enum SessionFormat {
  IN_PERSON
  REMOTE
  HYBRID
}

// DRAFT sessions are still being put together (dates/trainer/roster can
// change freely); VALIDATED is the point at which convocations should go
// out. CANCELLED is a manual dead-end (client feedback: staff need to call
// off a session — trainer unavailable, too few sign-ups — without deleting
// it or pretending it's still live). Archival is separate from status —
// see Session.archivedAt below — since a cancelled OR completed session can
// each independently be tidied out of the active Planning views.
enum SessionStatus {
  DRAFT
  VALIDATED
  CANCELLED
}

// Some OFPs run cohort training on a fixed calendar (FIXED_DATE — the
// existing model: a real start/end, a room or meeting link, a capacity).
// Others sell self-paced e-learning that's simply always available
// (ROLLING) — a learner's clock starts the moment *they* first log in, not
// on a shared date. Session.startsAt/endsAt stay non-null either way (kept
// simple rather than making half the schema nullable) — for ROLLING
// sessions they're set to a wide-open placeholder window at creation and
// the UI just doesn't show them; what actually matters for a rolling
// learner is Dossier.accessDurationDays/firstAccessedAt below.
enum SessionMode {
  FIXED_DATE
  ROLLING
}

model Session {
  id             String        @id @default(cuid())
  organization   Organization  @relation(fields: [organizationId], references: [id])
  organizationId String
  course         Course        @relation(fields: [courseId], references: [id])
  courseId       String
  mode           SessionMode   @default(FIXED_DATE)
  trainer        User?         @relation("SessionTrainer", fields: [trainerId], references: [id])
  trainerId      String?
  startsAt       DateTime
  endsAt         DateTime
  format         SessionFormat
  status         SessionStatus @default(DRAFT)
  location       String? // room name/address (IN_PERSON, HYBRID) or existing video link (REMOTE)
  capacity       Int
  // Auto-generated once, on first invitation send for a REMOTE/HYBRID
  // session — see /api/planning/sessions/[id]/invitations. Uses a public
  // Jitsi Meet room (no account/API key required) as the default video
  // provider since the spec doesn't mandate one; swap for a real
  // Zoom/Meet/Teams integration if the client picks a provider later.
  meetingLink    String?
  // Client feedback: past sessions used to just fall out of the "Liste" view
  // once endsAt passed, with no way to browse them again. This is a manual
  // toggle (staff-driven, not date-driven) so a cancelled-but-future session
  // can be tidied away too, and so "Archives" is an explicit place to look
  // rather than sessions silently vanishing.
  archivedAt     DateTime?
  // Heures d'enseignement de CETTE session, quand le détail par demi-journée
  // n'existe pas. C'est le cas de tout l'historique repris d'un ancien outil :
  // l'organisme connaît le total (c'est ce qu'il a déclaré au BPF), pas le
  // découpage matin/après-midi.
  //
  // Ce champ existe pour ne pas avoir à mentir dans SessionDay. Y inscrire un
  // total en le faisant passer pour une matinée aurait produit des créneaux
  // d'émargement inventés sur une session de 2022, et faussé l'écran de
  // signature. Voir resolveSessionHours pour l'ordre de priorité : les
  // demi-journées réelles priment toujours sur cette déclaration, qui prime
  // elle-même sur la durée nominale de la formation.
  declaredHours  Int?
  // Posé par l'import d'historique (/api/import/history). Deux usages :
  // distinguer ce qui vient d'un ancien outil de ce qui a été fait dans
  // Jalon, et empêcher les tâches « session terminée non facturée » de se
  // déclencher dessus — une session reprise a déjà été facturée ailleurs,
  // c'est la prémisse même de sa reprise.
  importedAt     DateTime?

  dossiers    Dossier[]
  invitations SessionInvitation[]
  attendances VirtualClassAttendance[]
  days        SessionDay[]

  @@index([organizationId])
  // courseId et trainerId : le filtre par propriétaire du formateur
  // (session: { trainerId }) traverse cette table sur /dossiers, /planning
  // et /formations. startsAt : toutes les fenêtres de dates du planning et
  // du tableau de bord.
  @@index([courseId])
  @@index([trainerId])
  @@index([startsAt])
}

// A session's actual teaching days. Additive on purpose: startsAt/endsAt
// above still bound the session as a whole (and every existing row keeps
// working with zero days), but a 2- or 3-day training — the norm for
// in-person inter-company sessions — could not be represented at all
// before this. Two things depended on that and were silently wrong:
//
//   1. The BPF declared (endsAt - startsAt) as hours, i.e. WALL-CLOCK time.
//      A Monday 9am → Wednesday 5pm session declared 56 h instead of 21 h,
//      on a legally binding annual return.
//   2. Attendance had nothing to hang off. Qualiopi audits check the
//      émargement per half-day (the contract Jalon itself ships says so),
//      which needs a per-day, per-half-day row to sign against.
model SessionDay {
  id             String   @id @default(cuid())
  session        Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId      String
  date           DateTime
  // Teaching hours actually planned for each half-day, or null when that
  // half-day isn't held (a morning-only day). Null is therefore meaningful:
  // it's both "no hours" and "nothing to sign here", which is what the
  // attendance screen renders from. Storing the number rather than deriving
  // it from start/end times is deliberate — a day running 9h-17h with an
  // hour for lunch is 7 teaching hours, not 8, and only the OF knows that.
  morningHours   Float?
  afternoonHours Float?
  order          Int      @default(0)

  attendance AttendanceEntry[]

  @@index([sessionId])
}

enum HalfDay {
  MORNING
  AFTERNOON
}

// One learner's presence for one half-day. The unique constraint is what
// makes signing idempotent: re-signing overwrites rather than stacking.
model AttendanceEntry {
  id               String     @id @default(cuid())
  sessionDay       SessionDay @relation(fields: [sessionDayId], references: [id], onDelete: Cascade)
  sessionDayId     String
  dossier          Dossier    @relation(fields: [dossierId], references: [id])
  dossierId        String
  halfDay          HalfDay
  signedAt         DateTime   @default(now())
  // Data-URL PNG of the on-screen signature. Kept inline rather than in Blob
  // storage: it's a few KB, and it has to survive exactly as long as the
  // attendance row it proves — this is audit evidence, not a file upload
  // someone might later archive or purge on its own.
  signatureDataUrl String?
  // Set when a staff member records the presence instead of the learner
  // signing themselves (paper sheet on the day, tablet out of battery). An
  // auditor doesn't weigh the two the same way, so the distinction is stored
  // rather than flattened into a single "present" boolean.
  recordedByUserId String?

  @@unique([sessionDayId, dossierId, halfDay])
  @@index([sessionDayId])
  @@index([dossierId])
}

// Electronic attendance for a REMOTE/HYBRID session, driven by the
// learner's browser actually being on the Jalon-hosted meeting room page
// (see /mon-espace/salle/[dossierId] and its heartbeat ping), not a staff
// checkbox ticked from memory after the fact. durationSeconds accumulates
// across reconnects — one row per (session, dossier) rather than one row
// per connection interval, since "how long were they actually present in
// total" is what an attendance certificate needs, not a raw connection log.
// Known honesty limit: this measures browser-tab presence on the room page,
// not camera/mic/audio-on state — there's no way to see that from an
// embedded, cross-origin Jitsi iframe without a real conferencing API.
model VirtualClassAttendance {
  id              String    @id @default(cuid())
  session         Session   @relation(fields: [sessionId], references: [id])
  sessionId       String
  dossier         Dossier   @relation(fields: [dossierId], references: [id])
  dossierId       String
  joinedAt        DateTime
  lastPingAt      DateTime
  leftAt          DateTime?
  durationSeconds Int       @default(0)

  @@unique([sessionId, dossierId])
  @@index([sessionId])
  @@index([dossierId])
}

// A session invitation is what gets sent to one enrolled learner (Dossier)
// for a Session: a video link (REMOTE/HYBRID, auto-generated once per
// session — see Session.meetingLink) and/or a venue map link derived from
// Session.location (IN_PERSON/HYBRID, computed on the fly, not stored).
// Sending one also flips Dossier.needsAssessmentDone's sibling
// `convocationSent` — this *is* the "convocation" step from the dossier
// journey checklist, not a separate concept.
model SessionInvitation {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  session        Session      @relation(fields: [sessionId], references: [id])
  sessionId      String
  dossier        Dossier      @relation(fields: [dossierId], references: [id])
  dossierId      String
  // Denormalized snapshot rather than a User relation — this is an audit
  // trail entry, not something that needs to stay live-joined to the user
  // (and it should still read sensibly if that user is later deactivated).
  sentByUserId   String
  sentByName     String
  sentAt         DateTime     @default(now())

  documents SessionInvitationDocument[]

  @@index([organizationId])
  @@index([sessionId])
  @@index([dossierId])
}

model SessionInvitationDocument {
  id           String            @id @default(cuid())
  invitation   SessionInvitation @relation(fields: [invitationId], references: [id])
  invitationId String
  document     Document          @relation(fields: [documentId], references: [id])
  documentId   String

  @@unique([invitationId, documentId])
}

// ---------------------------------------------------------------------------
// Commercial: quotes, invoices
// ---------------------------------------------------------------------------

enum DocStatus {
  DRAFT
  SENT
  SIGNED
  PAID
  OVERDUE
}

// Audit P1 : les trois étapes financières (À facturer / Facturé / Payé)
// doublonnaient l'espace Facturation, qui suit déjà l'état réel de chaque
// facture — elles fusionnent en COMPLETED (« Terminé »). Le pipeline ne
// décrit plus que l'avancement commercial ; l'argent se suit en Facturation.
enum PipelineStage {
  PROSPECT
  QUOTE_SENT
  CONTRACT_SIGNED
  SESSION_SCHEDULED
  COMPLETED
}

model Opportunity {
  id             String        @id @default(cuid())
  organization   Organization  @relation(fields: [organizationId], references: [id])
  organizationId String
  contact        Contact       @relation(fields: [contactId], references: [id])
  contactId      String
  label          String
  amountCents    Int?
  stage          PipelineStage @default(PROSPECT)
  createdAt      DateTime      @default(now())

  needsAssessmentRequests NeedsAssessmentRequest[]
  documents               Document[]
  // Sales rep who created it — spec §2 scopes SALES to "their own prospects";
  // null for opportunities created before this field existed or by non-Sales
  // roles who don't need the restriction.
  ownerId                 String?
  // Course the prospect is interested in — powers the Planning autosuggest
  // (match a session's course against CONTRACT_SIGNED opportunities to
  // propose who to enrol). Optional: pre-existing opportunities and ones
  // created without picking a course just won't be suggested anywhere.
  courseOfInterest        Course?                  @relation(fields: [courseOfInterestId], references: [id])
  courseOfInterestId      String?

  @@index([organizationId])
  @@index([stage])
}

model Quote {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  contact        Contact      @relation(fields: [contactId], references: [id])
  contactId      String
  dossier        Dossier?     @relation(fields: [dossierId], references: [id])
  dossierId      String?
  reference      String
  // La désignation de la prestation, mention obligatoire sur une facture
  // comme sur un devis. Elle n'était nulle part : l'objet n'était devinable
  // qu'à travers dossier → session → formation, et dossierId est nullable —
  // une facture directe n'avait donc aucun objet.
  description    String?
  amountCents    Int
  status         DocStatus    @default(DRAFT)
  createdAt      DateTime     @default(now())

  lines QuoteLine[]

  @@index([organizationId])
}

model Invoice {
  id                    String       @id @default(cuid())
  organization          Organization @relation(fields: [organizationId], references: [id])
  organizationId        String
  contact               Contact      @relation(fields: [contactId], references: [id])
  contactId             String
  dossier               Dossier?     @relation(fields: [dossierId], references: [id])
  dossierId             String?
  reference             String
  // Voir Quote.description : la désignation de la prestation est une mention
  // obligatoire de l'article 242 nonies A de l'annexe II au CGI.
  description           String?
  amountCents           Int
  status                DocStatus    @default(DRAFT)
  // Payment deadline — set at creation (NewInvoiceForm defaults to +30
  // days, staff can override), null on invoices created before this field
  // existed. Lets dashboardTasks.ts flag an invoice as overdue the moment
  // the date passes instead of relying solely on staff remembering to flip
  // status to OVERDUE by hand — same "automatic by default, manual override
  // always wins" principle as the rest of the app's status fields.
  dueDate               DateTime?
  // The invoice is NOT itself the compliant e-invoice — transmission via an
  // accredited platform is delegated per spec §5.3 / §7.2. This field just
  // records which provider (if any) handled the compliant transmission.
  einvoicingProvider    String? // "pennylane" | "sellsy" | "ppf" | null
  // BPF §5.13 needs revenue broken down by funding origin.
  fundingOrigin         String? // company | opco | public | individual
  // Set when this invoice is addressed to a funder (subrogation) rather
  // than to the client. contactId stays pointing at the learner's contact —
  // that's who the training was FOR, and what keeps the invoice reachable
  // from the dossier — while funderId says who PAYS.
  funder                Funder?      @relation(fields: [funderId], references: [id])
  funderId              String?
  // Position within a contract's payment schedule, when the invoice was
  // created by materialising one (see documentSending.ts). An échéancier
  // instalment IS an invoice with a dueDate — that is what makes the whole
  // existing machinery apply to it for free: overdue detection
  // (dashboardTasks.ts), bank reconciliation, automatic PAID once covered.
  // These two fields only add the context a lone invoice cannot carry:
  // "échéance 2 sur 4" reads very differently from "facture F-2026-114".
  // Null on every invoice created by hand.
  installmentNumber     Int?
  installmentTotal      Int?
  // Le document (contrat/convention) dont l'échéancier a produit cette
  // facture. Sert d'abord de garde d'idempotence côté prospect : un contact
  // sans dossier peut signer plusieurs contrats, chacun avec son échéancier,
  // et « une seule série d'échéances par dossier » ne veut alors rien dire.
  // Accessoirement, il rend traçable d'où vient une échéance — ce que le
  // couple installmentNumber/Total ne dit pas.
  sourceDocumentId      String?
  // Idempotency stamp for the invoice_overdue automation trigger — same
  // pattern as the dossier's *AutoReminderSentAt fields: one automated
  // nudge per invoice, ever. Staff relances stay manual and unlimited.
  overdueReminderSentAt DateTime?
  createdAt             DateTime     @default(now())

  payments           Payment[]
  bankTransactions   BankTransaction[]
  fundingCommitments FundingCommitment[]
  lines              InvoiceLine[]

  @@index([organizationId])
  // Drives the cron that issues a scheduled instalment shortly before it
  // falls due: without it the whole schedule would be e-mailed to the
  // learner on the day the contract is signed.
  @@index([status, dueDate])
  // Clés étrangères : agrégats financiers par dossier (fiche formation) et
  // par contact (tâches du tableau de bord) — sans ces index, chacun
  // balayait les 20 000 factures d'un organisme installé.
  @@index([contactId])
  @@index([dossierId])
}

// A single installment against an Invoice — an invoice can be settled in
// several partial payments (spec request: "suivi des paiements en
// plusieurs fois") rather than only ever being marked fully PAID at once.
// Recording one that brings the running total to/past Invoice.amountCents
// auto-flips the invoice to PAID (see /api/facturation/invoices/[id]/payments);
// a partial one just shows up as progress toward the total, status
// unchanged. `method` is free text (virement, carte, chèque, espèces,
// Stripe...) rather than an enum since real payment methods vary more than
// this scaffold needs to model rigidly.
// Le détail d'un devis ou d'une facture.
//
// Il n'y en avait aucun : un montant global et rien d'autre. Or un OPCO qui
// instruit une prise en charge demande le détail — « 2 stagiaires × 3 jours
// × 350 € », pas « 2 100 € ». Sans lui, l'organisme refaisait le décompte
// dans un tableur joint à part, que personne ne rapprochait ensuite.
//
// Le détail reste FACULTATIF : une facture à ligne unique est parfaitement
// valable, et les documents créés avant ce modèle n'en ont pas. Quand il y
// en a, la somme des lignes doit égaler amountCents — vérifié à la création.
// C'est amountCents qui reste la référence pour les paiements, le
// rapprochement bancaire et les totaux du tableau de bord : deux sources de
// vérité sur un montant, c'est un écart qui finit par se voir en compta.
model InvoiceLine {
  id             String  @id @default(cuid())
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId      String
  designation    String
  // Le prix unitaire est en centiers comme partout ailleurs ; seule la
  // quantité est un Float, parce qu'une demi-journée est une quantité
  // légitime alors qu'un demi-centime n'est pas un montant.
  quantity       Float
  unitPriceCents Int
  // L'unité telle qu'elle sera lue sur le document : « heures », « jours »,
  // « stagiaires », « forfait ». Texte libre, aucune liste fermée ne
  // couvrirait la variété réelle des prestations de formation.
  unit           String?
  order          Int     @default(0)

  @@index([invoiceId])
}

model QuoteLine {
  id             String  @id @default(cuid())
  quote          Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId        String
  designation    String
  quantity       Float
  unitPriceCents Int
  unit           String?
  order          Int     @default(0)

  @@index([quoteId])
}

model Payment {
  id               String       @id @default(cuid())
  organization     Organization @relation(fields: [organizationId], references: [id])
  organizationId   String
  invoice          Invoice      @relation(fields: [invoiceId], references: [id])
  invoiceId        String
  amountCents      Int
  paidAt           DateTime     @default(now())
  method           String?
  recordedByUserId String?
  recordedByName   String?
  createdAt        DateTime     @default(now())

  @@index([organizationId])
  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Bank reconciliation ("à valider" — see lib/bankReconciliation.ts)
//
// Deliberately NOT structured like Stripe (IntegrationCredential is
// per-org because Jalon must never sit in the OFP's money flow — see
// stripe.ts's comment). Here Jalon never touches money at all, only reads
// transaction data through an aggregator: BRIDGE_CLIENT_ID/CLIENT_SECRET
// are Jalon's own platform-level developer credentials (same shape as
// OPENAI_API_KEY/BREVO_API_KEY), and BankConnection is what scopes a
// single org's own bank consent under that shared platform account — the
// same relationship GOOGLE_CLIENT_ID/SECRET (one platform OAuth app) has
// to each org's own MailboxConnection tokens. Unlike those two, Bridge has
// no self-serve free production tier — going live needs a commercial
// agreement with Bridge, not just an env var (see lib/bridge.ts).
//
// A bank transaction label is free text ("VIR DUPONT JEAN") with no
// invoice reference, unlike Stripe's Checkout Session metadata — so
// matching here is only ever a ranked suggestion (lib/bankReconciliation.ts),
// never an automatic status flip. Staff always confirms or dismisses.
// ---------------------------------------------------------------------------

model BankConnection {
  id                   String       @id @default(cuid())
  organization         Organization @relation(fields: [organizationId], references: [id])
  organizationId       String
  provider             String       @default("bridge")
  institutionId        String // Bridge's numeric provider id, stored as string — known only once the item exists (see callback/route.ts)
  institutionName      String
  externalConnectionId String // Bridge item id — how the accounts below were fetched
  // pending = consent flow started, not yet completed (or needs a second
  // factor) at the bank; linked = accounts fetched and stored; expired =
  // the bank-side authentication needs renewing; error = the item failed
  // (declined, institution down...).
  status               String       @default("pending")
  connectedByUserId    String?
  connectedByName      String?
  lastSyncedAt         DateTime?
  createdAt            DateTime     @default(now())

  accounts BankAccount[]

  @@unique([organizationId, externalConnectionId])
  @@index([organizationId])
}

model BankAccount {
  id                String         @id @default(cuid())
  bankConnection    BankConnection @relation(fields: [bankConnectionId], references: [id])
  bankConnectionId  String
  externalAccountId String // Bridge account id
  iban              String?
  displayName       String?

  transactions BankTransaction[]

  @@unique([bankConnectionId, externalAccountId])
}

model BankTransaction {
  id               String       @id @default(cuid())
  organization     Organization @relation(fields: [organizationId], references: [id])
  organizationId   String
  bankAccount      BankAccount? @relation(fields: [bankAccountId], references: [id])
  bankAccountId    String? // null for source="csv_import" — a statement upload has no live account link
  source           String // "bridge" | "csv_import"
  // Deterministic id (Bridge's own transaction id, or a hash of
  // date+amount+label+account for CSV rows) — the only thing standing
  // between a re-sync/re-import and duplicate rows.
  externalId       String
  bookedAt         DateTime
  amountCents      Int // positive = credit (incoming) — the only ones ever surfaced as suggestions
  label            String // raw bank statement line, shown as-is, never edited
  counterpartyName String? // no source currently fills this in — Bridge and the CSV import both only ever give a free-text label, kept nullable for a future source that might

  matchedInvoice   Invoice?  @relation(fields: [matchedInvoiceId], references: [id])
  matchedInvoiceId String?
  // pending = awaiting staff review; confirmed = became a real Payment;
  // dismissed = staff said "not a match" — stays visible (audit trail,
  // avoids re-suggesting it), just out of the default "à valider" count.
  status           String    @default("pending")
  reviewedByUserId String?
  reviewedByName   String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@unique([organizationId, source, externalId])
  @@index([organizationId, status])
}

// ---------------------------------------------------------------------------
// Documents (generated or uploaded)
// ---------------------------------------------------------------------------

model Document {
  id                        String         @id @default(cuid())
  organization              Organization   @relation(fields: [organizationId], references: [id])
  organizationId            String
  dossier                   Dossier?       @relation(fields: [dossierId], references: [id])
  dossierId                 String?
  subcontractor             Subcontractor? @relation(fields: [subcontractorId], references: [id])
  subcontractorId           String?
  // A staff/team member's own document (CV, diplôme...) — same Document
  // model as dossier/subcontractor documents, just a third optional owner.
  user                      User?          @relation("UserDocuments", fields: [userId], references: [id])
  userId                    String?
  // Quatrième propriétaire possible : un prospect qui n'a pas encore de
  // dossier. Une convention envoyée depuis le CRM n'avait AUCUN de ces
  // liens — donc personne n'était prévenu quand le prospect signait, un
  // échéancier signé ne devenait jamais des factures, et le document
  // n'apparaissait ni dans la bibliothèque ni sur la fiche contact.
  //
  // Les deux, pas un seul : le contact porte le document (une opportunité
  // peut être supprimée sans que la convention signée disparaisse), et
  // l'opportunité porte l'étape commerciale à faire avancer à la signature.
  contact                   Contact?       @relation("ContactDocuments", fields: [contactId], references: [id])
  contactId                 String?
  opportunity               Opportunity?   @relation(fields: [opportunityId], references: [id])
  opportunityId             String?
  // Index déclarés ici pour rester alignés sur la migration : la fiche
  // contact et la bibliothèque listent toutes deux par propriétaire.
  title                     String
  // Uploaded/linked documents carry a fileUrl. Documents generated by the
  // toolkit's merge-field engine (see /api/documents/generate) carry
  // bodyText instead — the merged text itself, since there's no file
  // storage to put a real file into yet. One of the two is always set.
  fileUrl                   String?
  bodyText                  String?
  // Où en est le document dans son cycle de vie : "draft" | "final".
  //
  // Il n'existait aucune notion de brouillon — un document créé était un
  // document fini, ce qui obligeait à tout rédiger d'une traite. Le défaut
  // est "final" parce que c'est ce qu'étaient tous les documents existants
  // au moment de la migration ; seul le nouvel écran de création pose
  // explicitement "draft".
  //
  // Les deux autres états de l'espace Documents — envoyé, signé — ne sont
  // PAS stockés ici : ils se déduisent de sentByUserId et signatureStatus,
  // qui existent déjà. Les dupliquer créerait deux vérités sur un même
  // fait. Voir documentLifecycle.ts.
  status                    String         @default("final")
  // Regroupe les documents nés d'une seule action de l'organisme.
  //
  // Un contrat engage une personne nommée : générer pour une session de 8
  // apprenants produit 8 documents distincts, chacun signable séparément.
  // Sans cette clé, l'écran affiche 8 lignes presque identiques et la
  // question quotidienne — « qui n'a pas encore signé ? » — demande
  // d'ouvrir les 8. Null pour un document isolé.
  batchId                   String?
  templateOrigin            String? // which toolkit template this was generated from, if any
  // Denormalized from DocumentTemplate.category at generation/upload time —
  // a Document needs its own copy since the source template can be edited
  // or deleted later, and a manually-linked document (no template at all)
  // still needs a category to show up correctly in "Mes documents"
  // (src/app/(app)/documents/page.tsx). Defaults to "other" so existing
  // rows and manual adds without a picked category still file predictably.
  category                  String         @default("other")
  // Who sent it — nullable since older rows (uploads via
  // AddDossierDocumentForm, LMS certificates, /api/documents/generate) predate
  // this; also who a completed signature's staff notification email goes to.
  sentByUserId              String?
  sentByName                String?
  // "none" | "pending" | "signed" — set at send time (SendDocumentDialog's
  // "Demander une signature électronique" checkbox). Flipped to "signed" by
  // one of two paths: the learner's mon-espace stub sign action (no Yousign
  // key on file for this org), or the Yousign webhook handler below
  // (yousignSignatureRequestId set, real signature_request.done event).
  signatureStatus           String         @default("none")
  // Which engine carries this signature request: "yousign_org" (the OFP's
  // own Yousign key — they pay Yousign directly, never metered),
  // "yousign_platform" (Jalon's partner account — the only kind
  // lib/signatureQuota.ts counts for the Solo plan's included-10 + re-billed
  // overage), or "stub" (internal mon-espace click, free). Null when no
  // signature was requested, and on rows predating this field.
  signatureProvider         String?
  signedAt                  DateTime?
  // Set only when this document's signature was actually sent through
  // Yousign (src/lib/yousign.ts) rather than the internal stub — lets the
  // webhook handler (src/app/api/webhooks/yousign/[organizationId]) find
  // the right Document from the signature_request.id in the event payload.
  yousignSignatureRequestId String?        @unique
  createdAt                 DateTime       @default(now())
  // Set only on LMS certificates (templateOrigin "lms_certificate") issued
  // for a course with Course.certificateValidityMonths set — the date this
  // specific attestation stops being valid. expiryReminderSentAt is the
  // idempotency stamp for the certificate_expiring AutomationRule trigger,
  // same pattern as Dossier's *AutoReminderSentAt fields.
  expiresAt                 DateTime?
  expiryReminderSentAt      DateTime?
  // Client feedback: a document needed for a Qualiopi audit shouldn't be
  // permanently deleted just because it's no longer "current" — archiving
  // keeps the row (and its file) around, out of the active list, still
  // retrievable later. Deletion stays available separately for genuine
  // mistakes/duplicates.
  archivedAt                DateTime?
  // The payment schedule stated in this contract: [{ dueDate, amountCents,
  // label }], validated by lib/paymentSchedule.ts.
  //
  // It lives here, and not as Invoice rows, because the schedule exists from
  // the moment the contract is drafted while the invoices must not: a
  // contract that is never signed would otherwise leave phantom instalments
  // in Facturation. syncParcoursFromSignedDocument materialises them on
  // signature — that helper already runs on both signature paths, so there
  // is exactly one place where a schedule becomes money owed.
  paymentSchedule           Json?

  invitationLinks SessionInvitationDocument[]

  @@index([organizationId])
  @@index([contactId])
  @@index([opportunityId])
  @@index([batchId])
  // dossierId manquait alors que c'est le rattachement le plus utilisé :
  // fiche dossier, « Mes documents » côté apprenant, envois groupés.
  @@index([dossierId])
}

// The reusable document library (spec §5.8's "legal document toolkit" —
// scoped down here to a plain editable-text library, not the dynamic
// merge-field personalization engine the full toolkit describes; that
// remains a separate, bigger build). `organizationId: null` marks a
// starter template Jalon ships to every org; an org "adapts" one by
// creating its own copy (`forkedFromId` points back at the original) which
// they can then freely edit — the starter stays untouched as a reference.
model DocumentTemplate {
  id             String        @id @default(cuid())
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
  category       String // needs_assessment | convention | contrat_formation | convocation | eval_hot | eval_cold | cgv | internal_rules | other
  title          String
  bodyText       String
  forkedFromId   String?
  createdAt      DateTime      @default(now())
  // Client feedback: a template scoped to one formation (vs. the general
  // library) — its documents should auto-pull that course's own info
  // (title/duration/price) via mergeTemplate.ts's course.* fields. Null
  // means "general" — usable/generated for any dossier regardless of course.
  course         Course?       @relation(fields: [courseId], references: [id])
  courseId       String?

  // Ordered, conditional paragraphs — an alternative to the flat bodyText
  // above for documents whose wording legally varies by situation (a
  // convention/contrat de formation: statut de l'apprenant, modalité
  // distance/présentiel, subrogation...). When this list is non-empty it
  // REPLACES bodyText entirely at generation time (see
  // lib/documentAssembly.ts) — bodyText stays untouched as a harmless
  // leftover rather than a second, conflicting source of truth.
  blocks DocumentTemplateBlock[]

  @@index([organizationId])
  @@index([courseId])
}

// One paragraph of a conditional DocumentTemplate. `conditions` is either
// null (always included — the template's fixed/common text) or a JSON array
// of { questionKey, in: string[] } — see lib/documentQuestionnaire.ts for
// the question catalogue these keys reference — ANDed together, so a block
// can require several answers at once (e.g. "statut = personne physique" ET
// "modalité = distance"). Kept as a flat AND of equality checks rather than
// a general boolean-expression language: it covers every real branching
// case in a training contract without needing a non-technical admin to
// write or debug expression syntax.
model DocumentTemplateBlock {
  id         String           @id @default(cuid())
  template   DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String
  order      Int
  bodyText   String
  conditions Json?
  createdAt  DateTime         @default(now())

  @@index([templateId])
}

// The "send the needs assessment to a prospect" tool from the CRM: a
// snapshot of the template text at send time (so a later library edit
// doesn't retroactively change a request already sent out) plus a token
// for the unauthenticated public fill-in page. Deliberately scoped to just
// this one document category rather than a generic "any template, any
// recipient" engine — that's what was actually asked for; the library
// itself (DocumentTemplate above) still covers every other document type
// for internal use/download.
model NeedsAssessmentRequest {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  contact        Contact      @relation(fields: [contactId], references: [id])
  contactId      String
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id])
  opportunityId  String?
  // Le dossier visé, quand le recueil part d'un dossier déjà créé plutôt
  // que d'une opportunité en cours de vente. Nullable parce que les deux
  // cas coexistent : le recueil part souvent AVANT l'inscription.
  //
  // Sans lui, la complétion devait deviner : elle cochait « recueil fait »
  // sur TOUS les dossiers du contact, et rattachait une déclaration de
  // handicap — donnée sensible — au dossier le plus récent. Pour un
  // apprenant inscrit à deux formations, c'était un pari.
  dossier        Dossier?     @relation(fields: [dossierId], references: [id])
  dossierId      String?
  token          String       @unique
  templateBody   String
  responseText   String?
  status         String       @default("sent") // sent | completed
  sentByUserId   String
  sentByName     String
  sentAt         DateTime     @default(now())
  completedAt    DateTime?

  @@index([organizationId])
  @@index([contactId])
  @@index([dossierId])
}

// ---------------------------------------------------------------------------
// GDPR module
// ---------------------------------------------------------------------------

// Le registre des traitements de l'article 30. Il ne portait que le nom, la
// base légale et la durée — trois des sept mentions exigées. Un registre
// amputé de la finalité, des catégories de personnes et de données et des
// destinataires n'est pas un registre allégé : il est inopposable, et c'est
// la première pièce qu'un contrôleur CNIL demande.
//
// Les champs ajoutés sont nullables et non pas requis, pour que les lignes
// déjà saisies survivent à la migration ; l'écran les signale « à compléter »
// plutôt que de faire semblant qu'elles sont complètes.
model ProcessingActivity {
  id                String       @id @default(cuid())
  organization      Organization @relation(fields: [organizationId], references: [id])
  organizationId    String
  name              String
  // L'une des six clés de src/lib/rgpdLegalBases.ts. Reste un String et non
  // un enum : les valeurs libres saisies avant cette liste sont conservées
  // telles quelles, et l'affichage sait rendre les deux.
  legalBasis        String
  retentionPeriod   String
  // Article 30(1)(b) — la finalité poursuivie.
  purpose           String?
  // Article 30(1)(c) — catégories de personnes concernées, puis de données.
  dataSubjects      String?
  dataCategories    String?
  // Article 30(1)(d) — qui reçoit les données en dehors de l'organisme.
  recipients        String?
  // Article 30(1)(e) — un transfert hors UE change les obligations, d'où un
  // booléen explicite plutôt qu'une mention noyée dans les destinataires.
  transferOutsideEu Boolean      @default(false)
  transferDetails   String?
  // Article 30(1)(g) — les mesures de sécurité, décrites globalement.
  securityMeasures  String?
  riskFlag          String       @default("ok") // ok | to_review
  // Pourquoi la ligne demande une décision : accompagne riskFlag = to_review
  // au lieu de laisser deviner ce qu'il y a à revoir.
  reviewNote        String?
  createdAt         DateTime     @default(now())

  dpiaRecords DPIARecord[]

  @@index([organizationId])
}

model SubProcessor {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  name           String
  role           String
  location       String
  dpaStatus      String       @default("pending") // pending | signed
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model DPIARecord {
  id                   String             @id @default(cuid())
  organization         Organization       @relation(fields: [organizationId], references: [id])
  organizationId       String
  processingActivity   ProcessingActivity @relation(fields: [processingActivityId], references: [id])
  processingActivityId String
  subject              String
  riskLevel            String // low | moderate | high
  status               String             @default("required") // required | in_progress | validated | not_required
  createdAt            DateTime           @default(now())

  @@index([organizationId])
}

model RightsRequest {
  id                String       @id @default(cuid())
  organization      Organization @relation(fields: [organizationId], references: [id])
  organizationId    String
  requestType       String // access | erasure | portability | rectification
  personLabel       String
  deadline          DateTime
  status            String       @default("open") // open | in_progress | closed
  createdAt         DateTime     @default(now())
  // Plain id + denormalized name, no formal relation — same pattern as
  // EmailMessage.assignedToUserId/assignedToName elsewhere in this schema.
  // Client feedback: a request just sat there with no owner; this is who's
  // actually working it.
  assignedToUserId  String?
  assignedToName    String?
  // Set when a learner files this themselves via the unified support dialog
  // (mon-espace's "Aide & demandes") instead of staff creating it manually
  // from a dossier — null for the latter case.
  submittedByUserId String?
  details           String?

  @@index([organizationId])
}

// GDPR art. 33/34 — the register of security incidents/data breaches this
// module was missing entirely: DPIA and the processing register cover
// planned risk, this covers what actually happened. notifiedAuthorityAt /
// notifiedSubjectsAt track the two distinct 72h-window obligations (CNIL,
// then affected individuals if the breach is high-risk) separately, since
// one can legitimately happen without the other (low-risk breaches don't
// require notifying the people affected).
model DataBreach {
  id                  String       @id @default(cuid())
  organization        Organization @relation(fields: [organizationId], references: [id])
  organizationId      String
  title               String
  description         String
  discoveredAt        DateTime
  affectedDataTypes   String // free text — which personal data categories were exposed
  affectedPeopleCount Int?
  severity            String       @default("moderate") // low | moderate | high
  status              String       @default("investigating") // investigating | contained | closed
  notifiedAuthorityAt DateTime? // CNIL notification, due within 72h of discovery if required
  notifiedSubjectsAt  DateTime? // affected individuals, if high risk (art. 34)
  remediation         String?
  createdByName       String
  createdAt           DateTime     @default(now())

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Qualiopi module
// ---------------------------------------------------------------------------

// The RNQ isn't a single fixed list — it's republished by arrêté from time
// to time (see the "réforme référentiel" article on /actualites), with a
// status lifecycle (projet → publié → applicable → archivé) and its own
// indicator set per version. Each organization tracks which version it's
// currently auditing itself against (Organization.activeReferentielVersion)
// so switching to a new version — or previewing a still-draft one ahead of
// its application date — never silently rewrites another org's checklist.
// Périodic competency evaluation of an intervenant (internal TRAINER or
// external Subcontractor) — Qualiopi indicators 21-22, and the pilot's own
// real NC majeure from its 2022 initial audit ("l'organisme ne prévoit pas
// l'évaluation des compétences des différents intervenants"; the fix the
// auditor accepted was a systematic written evaluation). subjectName is
// denormalized so the evaluation history survives the person leaving.
// developmentPlan is the ind. 22 half: not just "how good are they" but
// "what professional development is planned".
model IntervenantEvaluation {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  user            User?          @relation(fields: [userId], references: [id])
  userId          String?
  subcontractor   Subcontractor? @relation(fields: [subcontractorId], references: [id])
  subcontractorId String?
  subjectName     String

  evaluatedAt     DateTime
  evaluatorName   String
  strengths       String?
  developmentPlan String?
  comment         String?

  createdAt DateTime @default(now())

  @@index([organizationId])
}

// One row per certification-body audit (initial, surveillance,
// renouvellement, complémentaire) — the org's real audit history, modeled
// on actual certifier paperwork (AB Certification "Synthèse de l'audit"
// 223-DS-09). Distinct from Organization.nextAuditDate (a manually set
// pointer, kept in sync when an audit announces the next one) and from the
// internal NonConformity model (complaints/suggestions log): findings here
// come from the CERTIFIER, are tied to an indicator, and follow the
// two-audit lifecycle (raised → corrective action accepted/levée → soldée
// at the NEXT audit).
model QualiopiAudit {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  type          String // initial | surveillance | renouvellement | complementaire
  auditDate     DateTime
  certifierName String
  auditorName   String?
  durationDays  Float?
  remote        Boolean   @default(false)
  // Conclusions et recommandations de la synthèse d'audit, en texte libre —
  // c'est là que vit "l'auditeur recommande le maintien de la certification".
  conclusions   String?
  nextAuditType String? // surveillance | renouvellement | complementaire
  nextAuditDate DateTime? // date prévisionnelle annoncée dans la synthèse

  findings QualiopiAuditFinding[]

  createdByName String
  createdAt     DateTime @default(now())

  @@index([organizationId])
}

// Une "Demande d'amélioration" (fiche de non-conformité d'audit, formulaire
// certificateur 223-DS-05) : écart constaté sur UN indicateur, majeure ou
// mineure, avec le plan de réponse de l'OF puis deux jalons distincts —
// "levée" quand l'auditeur accepte l'action corrective (quelques semaines
// après l'audit), "soldée" quand l'audit SUIVANT constate que l'action est
// toujours en œuvre. Les deux dates coexistent donc sur la même fiche.
model QualiopiAuditFinding {
  id      String        @id @default(cuid())
  audit   QualiopiAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  auditId String

  indicatorNumber  Int
  severity         String // majeure | mineure
  description      String // l'écart constaté (preuve tangible)
  immediateAction  String? // action curative immédiate
  rootCause        String? // analyse des causes de l'écart
  correctiveAction String? // action pour éviter la récurrence
  implementedAt    DateTime? // date de mise en œuvre annoncée

  status         String    @default("ouverte") // ouverte | levee | soldee
  liftedAt       DateTime? // levée de l'écart (action corrective acceptée)
  closedAt       DateTime? // écart soldé (à l'audit suivant)
  closureComment String?

  @@index([auditId])
}

model QualiopiReferentielVersion {
  id             String    @id @default(cuid())
  label          String // e.g. "RNQ 2022 (en vigueur)", "RNQ — Réforme 2026 (projet)"
  status         String    @default("projet") // projet | publie | applicable | archive
  publishedAt    DateTime?
  applicableFrom DateTime?
  notes          String?
  createdAt      DateTime  @default(now())

  indicators    QualiopiIndicator[]
  organizations Organization[]      @relation("ActiveReferentiel")
}

// Reference data for a given RNQ version — shared across every organization
// that has that version active (it's the same official criteria/indicators
// for everyone on that version), not tenant-scoped. Spec §7.3 asks that
// this be data-driven rather than hardcoded in the UI so it can be updated
// as the RNQ changes; this table is that. Labels here are working summaries
// for the scaffold — verify wording against the official France Compétences
// referential text before relying on them for an actual audit.
model QualiopiIndicator {
  id              String                     @id @default(cuid())
  version         QualiopiReferentielVersion @relation(fields: [versionId], references: [id])
  versionId       String
  number          Int // 1–33 within its version
  criterionNumber Int // 1–7
  label           String

  // Ce qui change par rapport à la version en vigueur, quand cette version-ci
  // en modifie la portée. Séparé du label plutôt que fondu dedans : un OF
  // reconnaît son indicateur par le libellé qu'il connaît, et ce qu'il veut
  // savoir d'une réforme c'est le delta, pas un texte reformulé qu'il devra
  // comparer lui-même. Null = inchangé par cette version.
  changeNote String?

  // "all" | "apprentissage". Le RNQ contient des indicateurs qui ne
  // s'appliquent qu'aux actions de formation par apprentissage (13 à 16, 20
  // aujourd'hui, plus le 33 du projet 2026). Sans cette information, un OF
  // qui ne fait pas d'apprentissage voit ces indicateurs comme non couverts
  // et croit avoir un trou de conformité qui n'existe pas.
  scope String @default("all")

  @@unique([versionId, number])
  @@index([versionId])
}

model AuditChecklistItem {
  id              String       @id @default(cuid())
  organization    Organization @relation(fields: [organizationId], references: [id])
  organizationId  String
  indicatorNumber Int
  gathered        Boolean      @default(false)

  // AI-generated, org-specific explanation of what this indicator actually
  // requires and what evidence to gather — "voir mon résumé personnalisé"
  // on the Préparation audit tab. Cached here (same per-org+indicator
  // granularity this model already has) so it's generated once, not on
  // every page load; personalizedSummaryAt lets the UI offer "Régénérer"
  // without needing a separate flag for "has one ever been generated."
  personalizedSummary   String?
  personalizedSummaryAt DateTime?

  @@unique([organizationId, indicatorNumber])
  @@index([organizationId])
}

model QualiopiIndicatorEvidence {
  id              String       @id @default(cuid())
  organization    Organization @relation(fields: [organizationId], references: [id])
  organizationId  String
  dossier         Dossier?     @relation(fields: [dossierId], references: [id])
  dossierId       String?
  criterionNumber Int // 1–7
  indicatorNumber Int // 1–32
  evidenceNote    String?

  @@index([organizationId])
}

model NonConformity {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  type           String // complaint | non_conformity | suggestion
  subject        String
  origin         String
  status         String       @default("open") // open | in_progress | resolved
  dueDate        DateTime?

  qualityRisks QualityRisk[]

  @@index([organizationId])
}

// Qualiopi indicator 28 (dispositif d'amélioration continue) asks for more
// than a complaint log — a real risk register with likelihood/severity,
// an owner, and a preventive/corrective plan. Deliberately a separate model
// from NonConformity rather than extending it: a complaint is a raw input
// ("someone reported X"), a risk is an analysis of it ("here's what could
// go wrong, how likely, how bad, what we're doing about it") — not every
// complaint becomes a risk, and a risk can originate from more than a
// complaint (a bad result, an audit finding, regulatory watch). The link is
// optional and one-directional (sourceNonConformityId), so promoting a
// complaint to a risk never mutates the original complaint record.
model QualityRisk {
  id                    String         @id @default(cuid())
  organization          Organization   @relation(fields: [organizationId], references: [id])
  organizationId        String
  course                Course?        @relation(fields: [courseId], references: [id])
  courseId              String?
  sourceNonConformity   NonConformity? @relation(fields: [sourceNonConformityId], references: [id])
  sourceNonConformityId String?

  risk              String
  origin            String // reclamation | resultat | audit | veille | autre
  probability       String // faible | moyenne | elevee
  severity          String // faible | moyenne | elevee
  ownerUserId       String?
  ownerName         String?
  preventiveMeasure String?
  correctiveAction  String?
  dueDate           DateTime?
  evidenceNote      String?
  status            String    @default("identifie") // identifie | en_cours | maitrise | clos

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([courseId])
}

// Qualiopi indicator 2 asks for published results indicators with an
// explicit calculation method, not just a headline number — an auditor (or
// a prospect) needs to see the definition, the formula, the period, and the
// population it was computed over. "computedFrom" records which real query
// produced computedValue (see src/lib/resultIndicators.ts) so a number is
// never just typed in and passed off as measured; "manual" is the one
// exception, for indicators this scaffold has no underlying data source
// for yet (e.g. a real satisfaction survey), and is flagged as such in the
// UI rather than presented the same way as a computed one.
model ResultIndicator {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  course         Course?      @relation(fields: [courseId], references: [id])
  courseId       String?

  label           String
  definition      String
  formula         String
  computedFrom    String // elearning_completion | hot_evaluation_rate | manual
  periodStart     DateTime
  periodEnd       DateTime
  totalPopulation Int
  respondents     Int
  exclusions      Int      @default(0)
  computedValue   Float? // percentage, 0–100

  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([courseId])
}

// ---------------------------------------------------------------------------
// LMS
// ---------------------------------------------------------------------------

model ElearningModule {
  id                        String   @id @default(cuid())
  course                    Course   @relation(fields: [courseId], references: [id])
  courseId                  String
  title                     String
  // Rich HTML (sanitizeRichText — src/lib/richText.ts), not plain text —
  // for "video"/"document" it's a supplementary note shown alongside the
  // file; for "page" it IS the module's entire content, so it needs real
  // formatting room, not a one-line caption.
  description               String?
  // "video" | "document" | "quiz" | "page" — drives which player the
  // learner portal renders and how progress is computed (playback
  // position, a manual "marquer comme lu", a graded attempt, or — "page" —
  // the same manual mark-as-read as "document" but with no file at all,
  // just the rich-text description). Free-text rather than an enum: cheap
  // to extend later (audio, scorm package, ...) without a migration.
  type                      String   @default("video")
  // Real uploaded content (Vercel Blob — see src/lib/storage.ts), not a
  // pasted external link like Document.fileUrl elsewhere in this app.
  // Unused for type "quiz" and "page" — a quiz's content lives in the
  // linked Quiz instead, a page's in `description` above.
  fileUrl                   String?
  fileName                  String?
  fileSizeBytes             Int?
  // Openable while the learner's withdrawal period is still running, when
  // the organisation set withdrawalAccessPolicy to "partial".
  //
  // Default false, and deliberately so: opening a teaching module IS
  // beginning to perform the contract. The organisation then delivers while
  // the learner can still withdraw and be reimbursed in full — a risk it
  // bears alone. Reserve this for what genuinely precedes the training:
  // livret d'accueil, programme, règlement intérieur, test de positionnement.
  availableDuringWithdrawal Boolean  @default(false)
  // Global position across the WHOLE course, unchanged by chapters below —
  // this is what unlockNextModuleIfNeeded (lib/lms.ts) and the sequential
  // unlock feature key off of. A chapter is purely a display grouping
  // layered on top; it deliberately does NOT get its own ordering field; a
  // chapter's position on screen is wherever its modules naturally fall in
  // this same global order, and reordering modules keeps working exactly
  // as it did before chapters existed.
  order                     Int      @default(0)
  createdAt                 DateTime @default(now())

  chapter     Chapter?                    @relation(fields: [chapterId], references: [id])
  chapterId   String?
  progress    ElearningProgress[]
  quiz        Quiz?
  versions    ElearningModuleVersion[]
  attachments ElearningModuleAttachment[]

  @@index([chapterId])
}

// A named grouping of modules within a course (client feedback: Teachizy's
// "chapitres" — an organizational level between "course" and "module" for
// courses with many modules). Deliberately no `order` field of its own —
// see the comment on ElearningModule.order above for why chapter position
// is derived from its modules' existing global order rather than tracked
// independently; keeps the pre-existing sequential-unlock logic completely
// untouched by this feature. Deleting a chapter detaches its modules
// (chapterId → null) rather than deleting them — a chapter is a label, not
// a container with any semantic weight of its own.
model Chapter {
  id        String   @id @default(cuid())
  course    Course   @relation(fields: [courseId], references: [id])
  courseId  String
  title     String
  createdAt DateTime @default(now())

  modules ElearningModule[]

  @@index([courseId])
}

// Supplementary files alongside a module's own primary content — client
// feedback: a video module needed to carry a companion handout/slide deck,
// not just the one video file ElearningModule.fileUrl already holds. Kept
// as its own table rather than reusing Document (dossier/subcontractor/
// user-scoped, carries signature/category fields that mean nothing for
// course content) — same reasoning that already keeps ElearningModule's
// own primary file separate from Document. Applies to any module type, not
// just video: a document or quiz module can just as reasonably ship a
// reference sheet alongside its main content.
model ElearningModuleAttachment {
  id            String          @id @default(cuid())
  module        ElearningModule @relation(fields: [moduleId], references: [id])
  moduleId      String
  title         String
  fileUrl       String
  fileName      String
  fileSizeBytes Int
  createdAt     DateTime        @default(now())

  @@index([moduleId])
}

// A history entry for a module's *previous* file, written right before it
// gets replaced (see POST /api/lms/modules/[id]/replace-file) — the current
// file always lives on ElearningModule itself, this table only holds what
// used to be there. Replacing a video a learner already has progress
// against would silently invalidate that progress (their recorded percent
// refers to a position in the old file, which may not even exist in the
// new one) — the replace endpoint requires an explicit confirmation in
// that case rather than swapping the file out from under them unannounced.
model ElearningModuleVersion {
  id             String          @id @default(cuid())
  module         ElearningModule @relation(fields: [moduleId], references: [id])
  moduleId       String
  fileUrl        String?
  fileName       String?
  fileSizeBytes  Int?
  replacedAt     DateTime        @default(now())
  replacedByName String

  @@index([moduleId])
}

// One quiz per module (type "quiz") — mirrors how a video/document module
// has exactly one piece of content. Passing a quiz completes the module the
// same way finishing a video does: ElearningProgress.percentComplete hits
// 100 and the existing auto-unlock-next-module logic in
// unlockNextModuleIfNeeded (src/lib/lms.ts) fires, same as any other module
// type — a quiz isn't a special case downstream of "did they finish this."
model Quiz {
  id              String          @id @default(cuid())
  module          ElearningModule @relation(fields: [moduleId], references: [id])
  moduleId        String          @unique
  minScorePercent Int             @default(70)
  maxAttempts     Int? // null = unlimited
  questions       QuizQuestion[]
  attempts        QuizAttempt[]
  createdAt       DateTime        @default(now())
}

model QuizQuestion {
  id                String  @id @default(cuid())
  quiz              Quiz    @relation(fields: [quizId], references: [id])
  quizId            String
  order             Int
  // single_choice | multiple_choice | true_false | short_answer
  type              String
  prompt            String
  // [{ id, text, correct }] for single_choice/multiple_choice/true_false —
  // the correct flags live here, not just in the answer-checking code, so
  // "what's the right answer" is inspectable/editable data, not logic.
  options           Json?
  // short_answer only — graded by exact match (trimmed, case-insensitive),
  // not semantic comparison; a deliberate scaffold limitation, not hidden.
  correctAnswerText String?

  @@index([quizId])
}

model QuizAttempt {
  id           String   @id @default(cuid())
  quiz         Quiz     @relation(fields: [quizId], references: [id])
  quizId       String
  dossier      Dossier  @relation(fields: [dossierId], references: [id])
  dossierId    String
  answers      Json // { [questionId]: string | string[] }
  scorePercent Int
  passed       Boolean
  submittedAt  DateTime @default(now())

  @@index([quizId])
  @@index([dossierId])
}

model ElearningProgress {
  id                  String          @id @default(cuid())
  dossier             Dossier         @relation(fields: [dossierId], references: [id])
  dossierId           String
  module              ElearningModule @relation(fields: [moduleId], references: [id])
  moduleId            String
  percentComplete     Int             @default(0)
  // Raw playback position, separate from percentComplete — percent is
  // "furthest point ever reached" (never regresses, see the progress
  // route), but resuming should pick up from wherever the learner actually
  // paused, which can be earlier than their furthest point if they went
  // back to re-watch something. Video only; documents have no position.
  lastPositionSeconds Int?
  lastEventAt         DateTime? // last tracked login/lesson/quiz event —
  // feeds Qualiopi evidence, see spec §5.12
  // This row IS the assignment record — a learner only sees a module once
  // one exists for their dossier (see /mon-espace). Created exclusively by
  // staff (see /api/lms/modules/[id]/assign); a learner can update their
  // own row's percentComplete but can no longer create one for themselves,
  // closing the implicit self-assignment gap the previous version had.
  assignedAt          DateTime        @default(now())
  assignedByUserId    String?
  assignedByName      String?
  // Set when the learner used "Passer cette vidéo" (Course.allowVideoSkip)
  // instead of actually watching to the end — percentComplete still jumps
  // to 100 so the next module unlocks, but this marks that 100 as unearned
  // so the UI can show it distinctly rather than as a genuine "Terminé".
  // Cleared by the progress route the moment a later real watch-through
  // (tracked the same way as any first-time viewing, including the
  // anti-scrub confirmation) reaches 100 for real.
  skippedAt           DateTime?

  @@unique([dossierId, moduleId])
  // L'unique couvre déjà dossierId seul (c'est son préfixe) mais pas
  // moduleId : les comptages Qualiopi filtrent par module.course.
  @@index([moduleId])
}

// ---------------------------------------------------------------------------
// Mailbox integration & inbox triage (spec §5.11)
// ---------------------------------------------------------------------------

model MailboxConnection {
  id                    String       @id @default(cuid())
  organization          Organization @relation(fields: [organizationId], references: [id])
  organizationId        String
  provider              String // "gmail" | "outlook" | "imap"
  accountEmail          String
  // OAuth tokens (gmail/outlook) encrypted at rest via src/lib/crypto.ts
  // (AES-256-GCM) — see TOKEN_ENCRYPTION_KEY. accessToken is refreshed on
  // every sync/send call rather than tracked for expiry, so its stored
  // value is mostly for debugging; refreshToken is what actually matters
  // long-term. Both are null for provider="imap".
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  // IMAP/SMTP (any other provider — OVH, Ionos, Zoho...) — same encryption,
  // a single password used for both since most hosts share credentials
  // across the two protocols. All null for gmail/outlook.
  passwordEncrypted     String?
  imapHost              String?
  imapPort              Int?
  smtpHost              String?
  smtpPort              Int?
  connectedAt           DateTime     @default(now())
  lastSyncedAt          DateTime?
  // Audit P1 : cocher/décocher une boîte sans la déconnecter. Décochée,
  // elle est ignorée par le cron ET par « Synchroniser maintenant », mais
  // ses messages déjà importés restent — c'est toute la différence avec
  // « Déconnecter », qui les efface.
  syncEnabled           Boolean      @default(true)
  // Fenêtre d'historique déjà rapatriée à la connexion (audit P1 : 90 jours).
  // Null tant que le rattrapage initial n'a pas eu lieu — les connexions
  // créées avant cette fonctionnalité le déclenchent donc à leur prochaine
  // synchronisation, une seule fois.
  backfilledAt          DateTime?

  emailMessages EmailMessage[]

  // An org can connect several mailboxes (several Gmail accounts, an IMAP
  // account, etc.) — uniqueness is per actual account, not per provider.
  @@unique([organizationId, provider, accountEmail])
  @@index([organizationId])
}

model EmailMessage {
  id                 String       @id @default(cuid())
  organization       Organization @relation(fields: [organizationId], references: [id])
  organizationId     String
  contact            Contact?     @relation(fields: [contactId], references: [id])
  contactId          String? // null = unmatched, goes to inbox triage
  suggestedDossierId String? // set only when a reliable signal was found (thread or reference match)
  matchBasis         String? // "thread" | "reference" | null
  fromAddress        String
  fromName           String? // display name from the "From" header, when present — feeds the "Nouveau prospect" pre-fill, not an AI guess
  subject            String
  snippet            String
  body               String? // full content — snippet stays a short preview for list views
  // Le message tel qu'il a été envoyé, mise en forme comprise.
  //
  // `body` reste le texte aplati : c'est lui que lisent la recherche, la
  // classification RGPD et l'IA de rédaction, qui n'ont que faire des tables
  // et des couleurs. Mais l'aplatir était aussi tout ce qu'on gardait, et un
  // e-mail s'affichait donc en un seul pavé sans paragraphes — htmlToPlainText
  // écrase les sauts de ligne avec le reste des espaces.
  //
  // Assaini à la synchronisation (lib/emailHtml.ts), jamais brut : ce champ
  // est rendu dans le navigateur d'un organisme connecté à ses données
  // clients. null pour les messages composés ici et les lignes de démo, qui
  // n'ont pas de version HTML d'origine.
  bodyHtml           String?
  externalId         String?      @unique // provider message id (e.g. Gmail's id) — dedupes repeated syncs; null for locally-composed replies and seed/demo rows
  externalThreadId   String? // Gmail threadId — lets a real reply land in the same Gmail conversation instead of starting a new one
  receivedAt         DateTime
  direction          String // "in" | "out"

  // Which connected mailbox this came from — null for seed/demo rows and
  // locally-composed replies that predate multi-mailbox support. Lets
  // /inbox filter to one mailbox and lets disconnecting one mailbox only
  // clear messages that actually came from it.
  mailboxConnection   MailboxConnection? @relation(fields: [mailboxConnectionId], references: [id])
  mailboxConnectionId String?

  // Team triage: who on the team is handling this message. Denormalized
  // name alongside the id so list views don't need an extra join, same
  // pattern as sentByUserId/sentByName elsewhere in this schema.
  assignedToUserId String?
  assignedToName   String?

  // Reply threading — a reply is its own "out" EmailMessage row pointing
  // back at the message it answers. No real delivery happens (no mailbox
  // is actually connected yet), so this just records the reply was
  // composed and against which thread.
  replyTo     EmailMessage?  @relation("EmailThread", fields: [inReplyToId], references: [id])
  inReplyToId String?
  replies     EmailMessage[] @relation("EmailThread")

  // AI classification for the RGPD register (spec: catch exercise-of-rights
  // requests — access/erasure/portability/rectification — buried in the
  // inbox before their legal 1-month deadline runs out, rather than relying
  // on a human to notice one among newsletters and prospect emails).
  // rgpdClassifiedAt is set the first time classification runs so a synced
  // message is never re-classified (cost control); rgpdSuggestedType holds
  // the open suggestion and is cleared once staff confirms or dismisses it
  // — same "AI suggests, human decides" shape as suggestedDossierId above,
  // never auto-creates the actual RightsRequest record on its own.
  rgpdClassifiedAt  DateTime?
  rgpdSuggestedType String? // access | erasure | portability | rectification | null
  rgpdReasoning     String?

  // "Ignorer" on /inbox sets this instead of deleting the row — a delete
  // left no trace that the message had been triaged, so it dedupes against
  // nothing and the next sync (which only looks at the last 25 messages by
  // externalId) recreates it. Setting ignoredAt keeps the externalId around
  // for that dedupe check while dropping the row out of the "à trier" list.
  ignoredAt DateTime?

  attachments EmailAttachment[]

  @@index([organizationId])
  @@index([contactId])
  // receivedAt : tri de toute la boîte mail. ignoredAt : filtre de la file
  // de triage. rgpdSuggestedType : le bandeau RGPD balayait la table
  // entière. assignedToUserId : les tâches « email assigné ».
  @@index([receivedAt])
  @@index([ignoredAt])
  @@index([rgpdSuggestedType])
  @@index([assignedToUserId])
  @@index([externalThreadId])
}

// One row per attachment on a synced message — same shape as
// ElearningModuleAttachment (fileUrl/fileName/fileSizeBytes on Vercel Blob,
// private store, served through an authenticated route, never a bare blob
// URL). Populated at sync time: gmailSync.ts fetches each part's bytes via
// Gmail's attachments API; imapSync.ts already has them from mailparser's
// parsed.attachments and just persists them — see persistEmailAttachments()
// in mailboxMatching.ts, shared so the two syncs can't drift.
model EmailAttachment {
  id             String       @id @default(cuid())
  emailMessage   EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)
  emailMessageId String
  fileName       String
  fileUrl        String
  fileSizeBytes  Int
  mimeType       String?
  createdAt      DateTime     @default(now())

  @@index([emailMessageId])
}

// Tracks a client-record-initiated send of a document/step that isn't
// already covered by a dedicated flow — NeedsAssessmentRequest handles the
// positioning test (with its own public fill-in page), SessionInvitation
// handles the convocation (with its meeting/map links). This is the same
// "sent, waiting on the other side" bookkeeping for the two remaining
// steps a staff member can trigger from a client record: the contract and
// platform access. No real email delivery — same constraint as everywhere
// else in this scaffold — but a real, queryable record of what was sent,
// when, and whether it was ever acted on, which is what "relances" needs.
model ClientOutreach {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  contact        Contact      @relation(fields: [contactId], references: [id])
  contactId      String
  dossier        Dossier?     @relation(fields: [dossierId], references: [id])
  dossierId      String?
  type           String // "contract" | "platform_access"
  status         String       @default("sent") // sent | acknowledged
  sentByUserId   String
  sentByName     String
  sentAt         DateTime     @default(now())
  acknowledgedAt DateTime?

  @@index([organizationId])
  @@index([contactId])
  @@index([dossierId])
}

// ---------------------------------------------------------------------------
// Third-party integration credentials (spec §3)
// ---------------------------------------------------------------------------

// Storage only — no feature in this scaffold actually calls out to any of
// these providers yet (see README). Plaintext here is NOT production-ready;
// spec §7.1 requires encryption at rest for exactly this kind of secret —
// same flag as MailboxConnection's token fields above. Wire real encryption
// (or a proper secrets manager) before this holds a real API key.
model IntegrationCredential {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  provider       String // brevo | yousign | pennylane | sellsy | google_oauth | microsoft_oauth
  apiKey         String?
  clientId       String?
  clientSecret   String?
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, provider])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Funding: who actually pays for a training, and how much of it.
//
// A French training is very often paid by several parties at once — an OPCO
// covers part of it, the employer the rest; or CPF plus an employer top-up.
// Invoice.fundingOrigin (a single category, kept for the BPF breakdown)
// cannot express that, which is why this pair of models exists rather than
// more fields on Invoice.
// ---------------------------------------------------------------------------

// The organisation's own list of funders it deals with. A referential rather
// than free text on each commitment: an OF works with the same handful of
// OPCOs all year, and typing "OPCO Atlas" slightly differently each time
// would make any per-funder total meaningless.
model Funder {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  name String
  // opco | cpf | france_travail | agefice | company | individual | public | other
  // Drives nothing functionally yet — it exists so the BPF breakdown can be
  // derived from real commitments later instead of Invoice.fundingOrigin.
  type String @default("opco")

  contactEmail    String?
  contactPhone    String?
  notes           String?
  // The funder's usual barème, as the OF experiences it: a rate per training
  // hour and/or a per-dossier cap. Only ever used to PREFILL a commitment's
  // amount as an editable estimate — real prise-en-charge decisions come from
  // the funder's written accord, never from these two numbers.
  hourlyRateCents Int?
  maxAmountCents  Int?
  // Soft delete: a funder that stops being used must not disappear from the
  // dossiers it already funded.
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())

  commitments FundingCommitment[]
  invoices    Invoice[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// One funder's share of one dossier. Several per dossier is the normal case.
model FundingCommitment {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  dossier        Dossier      @relation(fields: [dossierId], references: [id])
  dossierId      String
  funder         Funder       @relation(fields: [funderId], references: [id])
  funderId       String

  amountCents Int

  // Subrogation — the single most consequential field here: it decides WHO
  // gets invoiced. True (the usual case for an OPCO) means the OF bills the
  // funder directly; false means the learner/employer pays and claims the
  // money back themselves, so this amount still belongs on their invoice.
  subrogation Boolean @default(true)

  // The "accord de prise en charge". Its expiry is the most common reason a
  // funder ends up not paying, which is why the date is a real field and not
  // a line in `notes`.
  agreementNumber String?
  agreementDate   DateTime?
  validUntil      DateTime?

  // draft | deposited | instructing | granted | refused | invoiced | paid
  // Mirrors the real lifecycle of a funding request: an OF's daily question
  // is "which dossiers are sitting at the OPCO and since when", which needs
  // the préparation/dépôt/instruction distinction — a single "requested"
  // couldn't say whether anyone had actually sent anything.
  // Only granted/invoiced/paid count towards what's actually secured — see
  // computeFundingSummary in src/lib/funding.ts, which is the one place that
  // arithmetic lives.
  status String @default("draft")

  // Stamped automatically the first time status moves to "deposited" — this
  // is what powers "en attente de réponse depuis N jours". Kept when the
  // status advances (granted etc.): the deposit date stays true.
  depositedAt DateTime?

  // Set once the (subrogated) invoice for this funder's share is raised.
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  invoiceId String?

  notes     String?
  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([dossierId])
  @@index([funderId])
}

// ---------------------------------------------------------------------------
// Public API (/api/v1) — read-only in v1, plus outbound webhooks.
//
// Deliberately NOT modelled on IntegrationCredential: that table holds
// credentials Jalon uses to call OUT to a third party. These are credentials
// a third party uses to call IN, which is the opposite trust direction and
// the reason everything here is hashed and scoped.
// ---------------------------------------------------------------------------

model ApiKey {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  // What the key is for, so an admin can revoke the right one two years
  // later ("Zapier — export compta") without guessing.
  name String

  // First characters of the key, stored in clear so the UI can show which
  // key a row refers to. Not secret on its own.
  keyPrefix String

  // SHA-256 of the full key. NOT bcrypt: an API key is 32 random bytes, so
  // there is nothing to brute-force and nothing to rainbow-table — while
  // bcrypt's deliberate slowness would be paid on every single API call.
  // Same reasoning Stripe and GitHub apply to their own keys.
  keyHash String @unique

  // Coarse read scopes, e.g. ["read:dossiers", "read:invoices"]. A BI tool
  // pulling training volumes has no business reading learner contact details.
  scopes String[]

  lastUsedAt      DateTime?
  // Revoked rather than deleted: the row is the audit trail of what had
  // access, and to what, at a given time.
  revokedAt       DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  @@index([organizationId])
}

model Webhook {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  url    String
  // Event names subscribed to — see WEBHOOK_EVENTS in src/lib/apiKeys.ts.
  events String[]

  // Shared secret used to sign each delivery (HMAC-SHA256). The receiver
  // verifies it to be sure the call really comes from Jalon — without it a
  // webhook URL is an unauthenticated endpoint anyone can forge calls to.
  secret String

  active Boolean @default(true)

  // Last delivery outcome, kept so an OF can see a broken endpoint without
  // needing us to read logs for them.
  lastDeliveryAt     DateTime?
  lastDeliveryStatus Int?
  createdAt          DateTime  @default(now())

  @@index([organizationId])
}

// An OF asking Jalon to connect a tool we don't support yet. Persisted
// rather than only emailed: an email is the notification, not the record —
// if Brevo is down or the address changes, the request would vanish. Keeping
// the row also lets the asking organisation see what it already requested,
// so the same tool doesn't get sent three times by three people.
//
// Deliberately NOT modelled on Complaint: nothing here is tenant-internal
// workflow. The audience is the Jalon team, and the only thing the OF does
// with it afterwards is read the status.
model IntegrationRequest {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  // Captured at submission from the (always authenticated, always ADMIN_OF)
  // requester's session — same reasoning as Complaint.submittedByEmail: the
  // Jalon team needs to be able to reply without going digging for who
  // administers this organisation.
  requestedByUserId String
  requestedByName   String
  requestedByEmail  String

  toolName String
  // What they'd actually do with it. The useful part of the request: "we
  // want Pennylane" says much less than "our accountant is on Pennylane and
  // we re-key every invoice by hand".
  useCase  String

  status    String   @default("new") // new | reviewing | planned | declined | done
  createdAt DateTime @default(now())

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Public marketing site content — NOT tenant-scoped: this is Jalon's own
// editorial content and visitor list, not an OFP's data.
// ---------------------------------------------------------------------------

model NewsArticle {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String // qualiopi | rgpd | reglementation | produit
  excerpt     String
  body        String
  publishedAt DateTime @default(now())
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
}

// Demandes de démonstration entrantes — marketing/sales de Jalon LUI-MÊME,
// pas les contacts d'un OF client (ceux-là vivent dans Contact/Opportunity,
// scopés par organizationId). Ces lignes n'ont donc PAS d'organizationId :
// ce sont les prospects de Jalon. Capture pour rappel commercial ; aucune
// donnée sensible. Consultable via Prisma Studio en attendant une vue admin
// dédiée ; une notification email à l'équipe pourra être branchée une fois
// Brevo configuré. `status` suit l'avancement du traitement commercial.
model DemoRequest {
  id               String   @id @default(cuid())
  firstName        String
  lastName         String
  email            String
  phone            String?
  organizationName String
  orgSize          String? // tranche d'effectif / d'apprenants
  currentTool      String? // outil actuellement utilisé
  timeline         String? // échéance de changement envisagée
  message          String?
  source           String? // origine / campagne (UTM) si connue
  status           String   @default("new") // new | contacted | scheduled | done | lost
  createdAt        DateTime @default(now())

  @@index([email])
}

// Rate limiting for the unauthenticated surface (login, password reset,
// signup, public forms).
//
// Deliberately database-backed rather than an in-process counter: on Vercel
// consecutive requests land on different serverless instances, so an
// in-memory Map resets constantly and offers close to no protection against
// someone actually trying. One row per bucket+identifier, reused across
// windows (upsert on `key`), so the table stays small; stale rows are swept
// opportunistically in src/lib/rateLimit.ts.
model RateLimitCounter {
  id          String   @id @default(cuid())
  // "<bucket>:<identifier>", e.g. "login:marie@x.fr" or "signup:1.2.3.4".
  key         String   @unique
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@index([windowStart])
}

// Point de reprise de la chaîne quotidienne (voir src/lib/cronRunner.ts).
//
// Une ligne, une chaîne. Le champ qui compte est `nextStage` : le passage
// suivant démarre là, et non au début. Sans lui, l'ordre était fixe, donc
// les dernières étapes de la chaîne — synchronisation des boîtes mail,
// synthèses quotidiennes — n'étaient jamais atteintes dès que les
// premières mangeaient les 60 secondes allouées. Définitivement, et sans
// que rien ne le signale.
//
// `nextStage` est écrit AVANT de lancer l'étape, jamais après : c'est ce
// qui permet de reprendre une étape que l'hébergeur a coupée en plein
// milieu, sans lui laisser le temps d'écrire quoi que ce soit.
model CronCheckpoint {
  // Nom de la chaîne — "daily" est la seule pour l'instant.
  job            String    @id
  nextStage      String
  // Posé au début d'un passage, retiré à sa fin. Le trouver encore posé au
  // début du passage suivant est la SEULE façon de savoir que le précédent
  // a été coupé en vol : un processus tué n'écrit rien en partant.
  runInProgress  Boolean   @default(false)
  // Passages consécutifs coupés avant d'avoir pu se terminer. À 2 ou plus,
  // une étape ne tient pas dans une exécution — c'est ce qui rend la panne
  // visible au lieu de silencieuse.
  stalledRuns    Int       @default(0)
  // Dernier passage ayant tenté TOUTES les étapes.
  lastFullPassAt DateTime?
  updatedAt      DateTime  @updatedAt
}
